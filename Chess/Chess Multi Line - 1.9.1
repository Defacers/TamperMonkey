// ==UserScript==
// @name         Chess.com Multi-Line Hint (v1.9.1 Auto-Detect Side)
// @namespace    http://tampermonkey.net/
// @version      1.9.1
// @description  Multi-line chess hints + weighted auto-move + human jitter + auto-detect player color + polished responsive UI.
// @author       You
// @match        https://www.chess.com/play/*
// @match        https://www.chess.com/game/*
// @match        https://www.chess.com/analysis*
// @require      https://cdnjs.cloudflare.com/ajax/libs/chess.js/0.12.1/chess.min.js
// @grant        none
// @run-at       document-idle
// ==/UserScript==

(function () {
    'use strict';

    // ==================== CONFIG ====================
    const STORAGE_KEY = 'chessBestMoveState';
    const PANEL_POS_KEY = 'chessPanelPos';
    const SETTINGS_KEY = 'chessPanelSettings';
    const PANEL_COLLAPSED_KEY = 'chessPanelCollapsed';
    const DEBOUNCE_MS = 600;
    const OBSERVE_ROOT_SELECTOR = 'wc-simple-move-list';
    const BOARD_SELECTOR = 'wc-chess-board';
    const DEPTH = 14;
    const MULTIPV = 5;

    const IS_ANALYSIS = /\/analysis/.test(location.pathname);
    const ALLOW_AUTO_OUTSIDE_ANALYSIS_KEY = 'chessAllowAutoOutsideAnalysis';

    function isAutoOutsideAnalysisAllowed() {
        return localStorage.getItem(ALLOW_AUTO_OUTSIDE_ANALYSIS_KEY) === '1';
    }
    function setAutoOutsideAnalysisAllowed(v) {
        if (v) localStorage.setItem(ALLOW_AUTO_OUTSIDE_ANALYSIS_KEY, '1');
        else localStorage.removeItem(ALLOW_AUTO_OUTSIDE_ANALYSIS_KEY);
    }

    // ==================== SETTINGS ====================
    const DEFAULT_SETTINGS = {
        bestColor: '#7fa650',
        colorExcellent: '#4fa3d1',
        colorGood: '#5cb85c',
        colorInaccuracy: '#e6c84a',
        colorMistake: '#e67e22',
        colorBlunder: '#d9534f',

        bestLineWidth: 10,
        bestCircleRadius: 12,
        bestOpacity: 0.95,
        multiLineWidth: 6,
        multiLineOpacity: 0.7,
        multiCircleRadius: 8,

        showExcellent: true,
        showGood: true,
        showInaccuracy: true,
        showMistake: true,
        showBlunder: true,
        showBest: true,

        thresholdExcellent: 0.3,
        thresholdGood: 0.8,
        thresholdInaccuracy: 1.5,
        thresholdMistake: 3.0,

        autoMoveDelay: 400,
        autoMoveHumanize: true,
        autoMoveMode: 'drag',

        autoMoveStrategy: 'weighted',
        autoMoveWeightPower: 2.5,
        autoMoveMinWinrate: 0.30,
        autoMoveTopN: 5,
        autoMoveExcludeBlunder: true,
        autoMoveExcludeMistake: false,

        jitterScale: 0.35,
        reactionTimeMin: 200,
        reactionTimeMax: 900,
    };

    let SETTINGS = { ...DEFAULT_SETTINGS };
    function loadSettings() {
        try {
            const raw = localStorage.getItem(SETTINGS_KEY);
            if (!raw) return;
            const s = JSON.parse(raw);
            if (s && typeof s === 'object') SETTINGS = { ...DEFAULT_SETTINGS, ...s };
        } catch (e) {}
    }
    function saveSettings() {
        try { localStorage.setItem(SETTINGS_KEY, JSON.stringify(SETTINGS)); } catch (e) {}
    }
    loadSettings();

    // ==================== AUTO-DETECT PLAYER COLOR ====================
    const USER_OVERRIDE_KEY = 'cmh-user-override-side';
    let userOverrideSide = localStorage.getItem(USER_OVERRIDE_KEY) === '1';
    let detectedSide = null;
    let detectionAttempts = 0;
    const MAX_DETECTION_ATTEMPTS = 6;

    function detectPlayerColor() {
        const board = document.querySelector(BOARD_SELECTOR);

        // Priority 1: game-color attribute (live game)
        if (board) {
            const gc = board.getAttribute('game-color');
            if (gc === 'white' || gc === 'w') return { color: 'w', source: 'game-color' };
            if (gc === 'black' || gc === 'b') return { color: 'b', source: 'game-color' };
        }

        // Priority 2: player card component
        const userEl = document.querySelector('.play-controller-component.user, [data-test-element="user"]');
        if (userEl) {
            if (userEl.classList.contains('white')) return { color: 'w', source: 'player-card' };
            if (userEl.classList.contains('black')) return { color: 'b', source: 'player-card' };
        }

        // Priority 3: player-color attribute
        if (board) {
            const pc = board.getAttribute('player-color');
            if (pc === 'w' || pc === 'white') return { color: 'w', source: 'player-color' };
            if (pc === 'b' || pc === 'black') return { color: 'b', source: 'player-color' };
        }

        // Priority 4: flipped board (play page + analysis page)
        if (board) {
            const flipped = board.classList.contains('flipped');
            return { color: flipped ? 'b' : 'w', source: 'flipped' };
        }

        return null;
    }

    function applyDetectedSide(detected) {
        if (!detected) return;
        detectedSide = detected.color;
        const radio = document.querySelector(`input[name="cmh-side"][value="${detected.color}"]`);
        if (radio) radio.checked = true;
        updateDetectionBadge(detected);
    }

    function updateDetectionBadge(detected) {
        const badge = document.getElementById('cmh-auto-badge');
        const info = document.getElementById('cmh-detected-info');
        if (!badge || !info) return;

        if (userOverrideSide) {
            badge.textContent = 'MANUAL';
            badge.style.background = 'rgba(255,255,255,0.1)';
            badge.style.color = '#aaa';
            info.textContent = 'Manual override active';
            info.style.color = '#8b8783';
            return;
        }

        if (detected) {
            const colorLabel = detected.color === 'w' ? 'White' : 'Black';
            const sourceLabel = {
                'game-color': 'game',
                'player-card': 'player',
                'player-color': 'attr',
                'flipped': 'board',
                'manual': 'manual',
            }[detected.source] || detected.source;
            badge.textContent = 'AUTO ✓';
            badge.style.background = '#7fa650';
            badge.style.color = '#fff';
            info.textContent = `Detected: ${colorLabel} (${sourceLabel})`;
            info.style.color = '#a8d476';
        } else {
            badge.textContent = 'NOT DETECTED';
            badge.style.background = 'rgba(230,162,60,0.2)';
            badge.style.color = '#f0b85c';
            info.textContent = 'Set manually';
            info.style.color = '#c99456';
        }
    }

    function tryDetectSide() {
        if (userOverrideSide) return;
        const detected = detectPlayerColor();
        if (detected) {
            applyDetectedSide(detected);
            return;
        }
        if (detectionAttempts < MAX_DETECTION_ATTEMPTS) {
            detectionAttempts++;
            setTimeout(tryDetectSide, 1000);
        } else {
            updateDetectionBadge(null);
        }
    }

    function handleManualOverride() {
        userOverrideSide = true;
        localStorage.setItem(USER_OVERRIDE_KEY, '1');
        updateDetectionBadge(detectedSide ? { color: detectedSide, source: 'manual' } : null);
    }

    function resetAutoDetect() {
        userOverrideSide = false;
        localStorage.removeItem(USER_OVERRIDE_KEY);
        detectionAttempts = 0;
        tryDetectSide();
    }

    // ==================== SAN NORMALIZER ====================
    const FIGURINE_MAP = {
        '♔': 'K', '♚': 'K', '♕': 'Q', '♛': 'Q',
        '♖': 'R', '♜': 'R', '♗': 'B', '♝': 'B',
        '♘': 'N', '♞': 'N'
    };
    function normalizeSan(raw) {
        if (!raw) return '';
        let s = raw.trim();
        s = s.replace(/[♔♚♕♛♖♜♗♝♘♞]/g, ch => FIGURINE_MAP[ch] || ch);
        s = s.replace(/\s+/g, '');
        s = s.replace(/[!?]+/g, '');
        s = s.replace(/[+#]/g, '');
        s = s.replace(/[=\(]?([QRBNqrbn])\)?$/, (m, p) => '=' + p.toUpperCase());
        s = s.replace(/^0-0-0$/, 'O-O-O').replace(/^0-0$/, 'O-O');
        return s;
    }
    window.__normalizeSan = normalizeSan;

    // ==================== STATE ====================
    function loadState() {
        try {
            const raw = localStorage.getItem(STORAGE_KEY);
            if (!raw) return null;
            const s = JSON.parse(raw);
            if (!s || !Array.isArray(s.moves) || typeof s.fen !== 'string') return null;
            return s;
        } catch (e) { return null; }
    }
    function saveState(state) {
        try { localStorage.setItem(STORAGE_KEY, JSON.stringify(state)); } catch (e) {}
    }
    function clearState() { localStorage.removeItem(STORAGE_KEY); }

