    // ==================== PANEL DRAG ====================
    function setupDrag(panel) {
        const header = document.getElementById('cmh-drag-header');
        let dragging = false, offsetX = 0, offsetY = 0, activeId = null;

        function getPos(e) {
            if (e.touches && e.touches.length) return { x: e.touches[0].clientX, y: e.touches[0].clientY };
            if (e.changedTouches && e.changedTouches.length) return { x: e.changedTouches[0].clientX, y: e.changedTouches[0].clientY };
            return { x: e.clientX, y: e.clientY };
        }

        function start(e) {
            if (e.target && e.target.closest('button')) return;
            dragging = true;
            const p = getPos(e);
            const rect = panel.getBoundingClientRect();
            offsetX = Math.max(0, Math.min(p.x - rect.left, rect.width));
            offsetY = Math.max(0, Math.min(p.y - rect.top, rect.height));
            if (e.pointerId !== undefined) activeId = e.pointerId;
            if (e.cancelable) e.preventDefault();
        }
        function move(e) {
            if (!dragging) return;
            if (activeId !== null && e.pointerId !== undefined && e.pointerId !== activeId) return;
            const p = getPos(e);
            let x = p.x - offsetX, y = p.y - offsetY;
            const maxX = window.innerWidth - panel.offsetWidth;
            const maxY = window.innerHeight - panel.offsetHeight;
            x = Math.max(0, Math.min(x, maxX));
            y = Math.max(0, Math.min(y, maxY));
            panel.style.left = x + 'px';
            panel.style.top = y + 'px';
            if (e.cancelable) e.preventDefault();
        }
        function end(e) {
            if (!dragging) return;
            dragging = false;
            activeId = null;
            try {
                localStorage.setItem(PANEL_POS_KEY, JSON.stringify({
                    x: parseInt(panel.style.left, 10) || 12,
                    y: parseInt(panel.style.top, 10) || 12
                }));
            } catch (err) {}
            if (e && e.cancelable) e.preventDefault();
        }

        if (window.PointerEvent) {
            header.addEventListener('pointerdown', start, { passive: false });
            document.addEventListener('pointermove', move, { passive: false });
            document.addEventListener('pointerup', end, { passive: false });
            document.addEventListener('pointercancel', end, { passive: false });
        } else {
            header.addEventListener('mousedown', start);
            document.addEventListener('mousemove', move);
            document.addEventListener('mouseup', end);
            header.addEventListener('touchstart', start, { passive: false });
            document.addEventListener('touchmove', move, { passive: false });
            document.addEventListener('touchend', end, { passive: false });
        }
    }

    function clampPanelToViewport(panel) {
        const rect = panel.getBoundingClientRect();
        let x = parseInt(panel.style.left, 10) || 12;
        let y = parseInt(panel.style.top, 10) || 12;
        const maxX = Math.max(0, window.innerWidth - rect.width);
        const maxY = Math.max(0, window.innerHeight - rect.height);
        x = Math.max(0, Math.min(x, maxX));
        y = Math.max(0, Math.min(y, maxY));
        panel.style.left = x + 'px';
        panel.style.top = y + 'px';
    }

    createPanel();

    // ==================== UI BINDINGS ====================
    function bindUI() {
        const $ = id => document.getElementById(id);
        const on = (id, evt, fn) => { const el = $(id); if (el) el.addEventListener(evt, fn); };

        on('cmh-btn-collapse', 'click', (e) => {
            e.stopPropagation();
            const body = $('cmh-body');
            const hidden = body.style.display === 'none';
            body.style.display = hidden ? 'flex' : 'none';
            $('cmh-btn-collapse').innerHTML = hidden
                ? '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="width:16px;height:16px;"><polyline points="6 9 12 15 18 9"/></svg>'
                : '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="width:16px;height:16px;"><polyline points="9 18 15 12 9 6"/></svg>';
            localStorage.setItem(PANEL_COLLAPSED_KEY, hidden ? '0' : '1');
        });

        const toggleSettings = (e) => {
            e.stopPropagation();
            $('cmh-settings').classList.toggle('open');
        };
        on('cmh-btn-settings', 'click', toggleSettings);
        on('cmh-btn-settings2', 'click', toggleSettings);

        on('cmh-btn-analyze', 'click', () => analyze());

        on('cmh-btn-reset', 'click', () => {
            clearState();
            setStatus('State cleared.', 'ok');
            $('cmh-chosen').classList.add('hidden');
            $('cmh-moves-section').style.display = 'none';
            $('cmh-empty').style.display = 'block';
            lastKnownMoveCount = -1;
            lastKnownLastMove = '';
            lastAnalyzedFen = null;
            lastBestMove = null;
            lastLines = [];
            clearOverlay();
            redrawAllArrows();
        });

        // Colors
        ['bestColor','colorExcellent','colorGood','colorInaccuracy','colorMistake','colorBlunder'].forEach(key => {
            on('cmh-set-' + key, 'input', e => {
                SETTINGS[key] = e.target.value;
                saveSettings();
                redrawAllArrows();
            });
        });
        ['showBest','showExcellent','showGood','showInaccuracy','showMistake','showBlunder'].forEach(key => {
            on('cmh-set-' + key, 'change', e => {
                SETTINGS[key] = e.target.checked;
                saveSettings();
                redrawAllArrows();
            });
        });

        const bindRange = (id, labelId, key, isInt, after, suffix = '') => {
            const el = $(id); const lbl = $(labelId);
            if (!el) return;
            el.addEventListener('input', e => {
                const v = isInt ? parseInt(e.target.value, 10) : parseFloat(e.target.value);
                SETTINGS[key] = v;
                if (lbl) lbl.textContent = (isInt || Number.isInteger(v) ? v : v.toFixed(2)) + suffix;
                saveSettings();
                if (after) after();
            });
        };
        bindRange('cmh-set-bestW', 'cmh-lbl-bestW', 'bestLineWidth', false, redrawAllArrows);
        bindRange('cmh-set-multiW', 'cmh-lbl-multiW', 'multiLineWidth', false, redrawAllArrows);
        bindRange('cmh-set-multiO', 'cmh-lbl-multiO', 'multiLineOpacity', false, redrawAllArrows);
        bindRange('cmh-set-thEx', 'cmh-lbl-thEx', 'thresholdExcellent', false, redrawAllArrows);
        bindRange('cmh-set-thGood', 'cmh-lbl-thGood', 'thresholdGood', false, redrawAllArrows);
        bindRange('cmh-set-thIn', 'cmh-lbl-thIn', 'thresholdInaccuracy', false, redrawAllArrows);
        bindRange('cmh-set-thMis', 'cmh-lbl-thMis', 'thresholdMistake', false, redrawAllArrows);
        bindRange('cmh-set-wp', 'cmh-lbl-wp', 'autoMoveWeightPower', false);
        bindRange('cmh-set-minwr', 'cmh-lbl-minwr', 'autoMoveMinWinrate', false);
        bindRange('cmh-set-topN', 'cmh-lbl-topN', 'autoMoveTopN', true);
        bindRange('cmh-set-jitter', 'cmh-lbl-jitter', 'jitterScale', false);
        bindRange('cmh-set-rtMin', 'cmh-lbl-rtMin', 'reactionTimeMin', true, null, 'ms');
        bindRange('cmh-set-rtMax', 'cmh-lbl-rtMax', 'reactionTimeMax', true, null, 'ms');
        bindRange('cmh-set-delay', 'cmh-lbl-delay', 'autoMoveDelay', true, null, 'ms');

        on('cmh-set-strategy', 'change', e => { SETTINGS.autoMoveStrategy = e.target.value; saveSettings(); });
        on('cmh-set-mode', 'change', e => { SETTINGS.autoMoveMode = e.target.value; saveSettings(); });

        on('cmh-set-humanize', 'change', e => { SETTINGS.autoMoveHumanize = e.target.checked; saveSettings(); });
        on('cmh-set-excludeBlunder', 'change', e => { SETTINGS.autoMoveExcludeBlunder = e.target.checked; saveSettings(); });
        on('cmh-set-excludeMistake', 'change', e => { SETTINGS.autoMoveExcludeMistake = e.target.checked; saveSettings(); });

        on('cmh-allow-outside', 'change', e => {
            if (e.target.checked && !IS_ANALYSIS) {
                const ok = confirm(
                    'PERINGATAN: Auto-move di luar halaman analisis.\n\n' +
                    'Jika digunakan di permainan berperingkat, akun Anda bisa diblokir permanen oleh Chess.com.\n\n' +
                    'Gunakan hanya untuk permainan kasual, bot, atau latihan.\n\n' +
                    'Lanjutkan?'
                );
                if (!ok) { e.target.checked = false; return; }
            }
            setAutoOutsideAnalysisAllowed(e.target.checked);
            const autoMove = $('cmh-auto-move');
            if (autoMove) {
                if (e.target.checked) {
                    autoMove.disabled = false;
                    setStatus('Override enabled — auto-move available everywhere.', 'warn');
                } else if (!IS_ANALYSIS) {
                    autoMove.disabled = true;
                    autoMove.checked = false;
                    setStatus('Override disabled — auto-move restricted to analysis.', 'ok');
                }
            }
        });

        // ==================== AUTO-DETECT BINDINGS ====================
        document.querySelectorAll('input[name="cmh-side"]').forEach(r => {
            r.addEventListener('change', () => {
                if (r.checked && !userOverrideSide) {
                    handleManualOverride();
                }
            });
        });

        on('cmh-btn-redetect', 'click', () => {
            resetAutoDetect();
            showToast('🔄 Auto-detect re-enabled', 'ok');
        });

        // Initial detection (retry loop handled inside)
        tryDetectSide();
    }

    // ==================== TOAST + STATUS ====================
    let toastTimer = null;
    function showToast(msg, type = 'ok') {
        let toast = document.getElementById('cmh-toast');
        if (!toast) {
            toast = document.createElement('div');
            toast.id = 'cmh-toast';
            toast.className = 'cmh-toast';
            document.body.appendChild(toast);
        }
        toast.className = 'cmh-toast show ' + type;
        toast.textContent = msg;
        clearTimeout(toastTimer);
        toastTimer = setTimeout(() => toast.classList.remove('show'), 2200);
    }

    function setStatus(msg, type = 'ok') {
        const el = document.getElementById('cmh-status');
        if (!el) return;
        const isLoad = msg.includes('Analyzing') || msg.includes('loading') || msg.includes('Initializing');
        el.className = 'cmh-status'
            + (type === 'warn' ? ' cmh-status-warn' : type === 'error' ? ' cmh-status-error' : '')
            + (isLoad ? ' cmh-status-loading' : '');
        el.textContent = msg;
    }

    // ==================== ENGINE ====================
    let sfWorker = null;

    async function initEngine() {
        try {
            setStatus('Initializing engine...');
            const resp = await fetch('https://cdnjs.cloudflare.com/ajax/libs/stockfish.js/10.0.1/stockfish.js');
            if (!resp.ok) throw new Error('HTTP ' + resp.status);
            const code = await resp.text();
            sfWorker = new Worker(URL.createObjectURL(new Blob([code], { type: 'application/javascript' })));
            sfWorker.postMessage('setoption name MultiPV value ' + MULTIPV);
            setStatus('Engine ready. Waiting for moves...');
        } catch (e) {
            setStatus('Engine load failed: ' + e.message, 'error');
        }
    }
    initEngine();

    // ==================== MOVE LIST EXTRACTION ====================
    function extractSanFromNode(node) {
        let san = '';
        for (const child of node.childNodes) {
            if (child.nodeType === Node.TEXT_NODE) san += child.textContent;
            else if (child.nodeType === Node.ELEMENT_NODE) {
                if (child.hasAttribute('data-move-list-el')) continue;
                if (child.classList && child.classList.contains('timestamp')) continue;
                const fig = child.getAttribute('data-figurine');
                if (fig) san += fig;
                else san += extractSanFromNode(child);
            }
        }
        return san;
    }

    function readMovesFromList() {
        const list = document.querySelector(OBSERVE_ROOT_SELECTOR);
        if (!list) return null;
        const moves = [];
        list.querySelectorAll('[data-node]').forEach(node => {
            const raw = extractSanFromNode(node);
            const normalized = normalizeSan(raw);
            if (normalized) moves.push(normalized);
        });
        return moves.length ? moves : null;
    }

    // ==================== POSITION BUILDING ====================
    function rebuildFromSaved(saved) {
        const chess = new Chess();
        for (const san of saved.moves) if (!chess.move(san)) break;
        return chess;
    }

    function buildPosition() {
        const domMoves = readMovesFromList();
        const saved = loadState();
        if (!domMoves && !saved) return null;
        if (!domMoves) return { chess: rebuildFromSaved(saved), moves: saved.moves };
        if (!saved) {
            const chess = new Chess();
            const applied = [];
            for (const san of domMoves) { if (!chess.move(san)) break; applied.push(san); }
            saveState({ moves: applied, fen: chess.fen(), ts: Date.now() });
            return { chess, moves: applied };
        }
        let common = 0;
        const minLen = Math.min(domMoves.length, saved.moves.length);
        for (let i = 0; i < minLen; i++) { if (domMoves[i] === saved.moves[i]) common++; else break; }
        if (common === saved.moves.length && domMoves.length > saved.moves.length) {
            const chess = new Chess(saved.fen);
            const applied = saved.moves.slice();
            for (let i = saved.moves.length; i < domMoves.length; i++) {
                if (!chess.move(domMoves[i])) break;
                applied.push(domMoves[i]);
            }
            saveState({ moves: applied, fen: chess.fen(), ts: Date.now() });
            return { chess, moves: applied };
        }
        if (common === domMoves.length && common === saved.moves.length) return { chess: rebuildFromSaved(saved), moves: saved.moves };
        if (common === domMoves.length && domMoves.length < saved.moves.length) return { chess: rebuildFromSaved(saved), moves: saved.moves };
        const chess = new Chess();
        const applied = [];
        for (const san of domMoves) { if (!chess.move(san)) break; applied.push(san); }
        saveState({ moves: applied, fen: chess.fen(), ts: Date.now() });
        return { chess, moves: applied };
    }

    // ==================== ANALYZE ====================
    let analyzing = false;
    let lastBestMove = null;
    let lastAnalyzedFen = null;
    let lastLines = [];
    let lastSide = null;

    function classifyMove(score, bestScore) {
        const drop = bestScore - score;
        if (drop <= SETTINGS.thresholdExcellent) return 'excellent';
        if (drop <= SETTINGS.thresholdGood) return 'good';
        if (drop <= SETTINGS.thresholdInaccuracy) return 'inaccuracy';
        if (drop <= SETTINGS.thresholdMistake) return 'mistake';
        return 'blunder';
    }

    function scoreToLabel(score) {
        if (score >= 100) return '+M';
        if (score <= -100) return '-M';
        return (score > 0 ? '+' : '') + score.toFixed(2);
    }

    function capitalize(s) { return s.charAt(0).toUpperCase() + s.slice(1); }

    function evalToWinrate(evalPawns) {
        return 1 / (1 + Math.pow(10, -evalPawns / 4));
    }

    function pickMoveWeighted(candidates) {
        if (!candidates || candidates.length === 0) return null;
        const strategy = SETTINGS.autoMoveStrategy;
        const topN = Math.min(SETTINGS.autoMoveTopN, candidates.length);
        const top = candidates.slice(0, topN);
        const filtered = top.filter(c => {
            if (SETTINGS.autoMoveExcludeBlunder && c.category === 'blunder') return false;
            if (SETTINGS.autoMoveExcludeMistake && c.category === 'mistake') return false;
            if (c.winrate < SETTINGS.autoMoveMinWinrate) return false;
            return true;
        });
        const pool = filtered.length > 0 ? filtered : [top[0]];
        if (strategy === 'best') return pool[0];
        if (strategy === 'random') return pool[Math.floor(Math.random() * pool.length)];
        const power = SETTINGS.autoMoveWeightPower;
        const weights = pool.map(c => Math.pow(Math.max(0.001, c.winrate), power));
        const total = weights.reduce((a, b) => a + b, 0);
        let r = Math.random() * total;
        for (let i = 0; i < pool.length; i++) { r -= weights[i]; if (r <= 0) return pool[i]; }
        return pool[pool.length - 1];
    }

    function analyze() {
        if (analyzing) return;
        if (!sfWorker) { setStatus('Engine not ready', 'error'); return; }
        if (typeof Chess === 'undefined') { setStatus('chess.js not loaded', 'error'); return; }

        const side = document.querySelector('input[name="cmh-side"]:checked').value;
        const result = buildPosition();
        if (!result) { setStatus('No moves to analyze', 'warn'); return; }

        const { chess, moves } = result;
        if (chess.turn() !== side) {
            setStatus(`It is ${chess.turn() === 'w' ? 'White' : 'Black'}'s turn`, 'warn');
            document.getElementById('cmh-chosen').classList.add('hidden');
            document.getElementById('cmh-move-list').innerHTML = '';
            document.getElementById('cmh-moves-section').style.display = 'none';
            document.getElementById('cmh-empty').style.display = 'block';
            clearOverlay();
            return;
        }

        const fen = chess.fen();
        if (fen === lastAnalyzedFen && lastBestMove) return;

        analyzing = true;
        lastLines = [];
        lastSide = side;
        setStatus(`Analyzing position (${moves.length} moves)...`, 'loading');
        document.getElementById('cmh-moves-section').style.display = 'none';
        document.getElementById('cmh-empty').style.display = 'none';
        document.getElementById('cmh-chosen').classList.add('hidden');

        sfWorker.postMessage('setoption name MultiPV value ' + MULTIPV);
        sfWorker.postMessage('position fen ' + fen);
        sfWorker.postMessage('go depth ' + DEPTH);

        const lines = {};
        sfWorker.onmessage = function (event) {
            const line = event.data;
            if (typeof line !== 'string') return;
            if (line.startsWith('info') && line.indexOf(' pv ') !== -1) {
                const mpvMatch = line.match(/multipv (\d+)/);
                const mpvIdx = mpvMatch ? parseInt(mpvMatch[1], 10) : 1;
                const scoreMatch = line.match(/score (cp|mate) (-?\d+)/);
                if (!scoreMatch) return;
                const scoreType = scoreMatch[1];
                const scoreVal = parseInt(scoreMatch[2], 10);
                const scorePawns = scoreType === 'cp' ? scoreVal / 100 : (scoreVal > 0 ? 100 : -100);
                const pvMatch = line.match(/\spv\s+(\S+)/);
                const firstMove = pvMatch ? pvMatch[1] : null;
                if (!firstMove) return;
                lines[mpvIdx] = { uci: firstMove, score: scorePawns };
            }
            if (line.startsWith('bestmove')) {
                analyzing = false;
                const arr = Object.keys(lines).map(k => ({ idx: parseInt(k, 10), ...lines[k] }));
                arr.sort((a, b) => a.idx - b.idx);
                lastLines = arr;
                if (arr.length === 0) { setStatus('No move available', 'warn'); return; }
                const best = arr[0];
                lastBestMove = best.uci;
                lastAnalyzedFen = fen;
                setStatus(`Analysis complete — ${arr.length} candidates found.`, 'ok');
                renderMultiMoveList(arr);
                drawAllArrows(arr);
                maybeAutoMoveSmart(arr, side);
            }
        };
    }

    // ==================== RENDER MOVE LIST ====================
    const CATEGORY_META = {
        best: { label: 'Best', icon: '★' },
        excellent: { label: 'Excellent', icon: '◆' },
        good: { label: 'Good', icon: '●' },
        inaccuracy: { label: 'Inaccuracy', icon: '▲' },
        mistake: { label: 'Mistake', icon: '⚠' },
        blunder: { label: 'Blunder', icon: '✖' },
    };

    function renderMultiMoveList(lines) {
        const listEl = document.getElementById('cmh-move-list');
        const sectionEl = document.getElementById('cmh-moves-section');
        if (!listEl) return;
        listEl.innerHTML = '';
        const bestScore = lines[0].score;
        let anyShown = false;
        lines.forEach((line, i) => {
            const isBest = i === 0;
            let category, color;
            if (isBest) { category = 'best'; color = SETTINGS.bestColor; }
            else {
                category = classifyMove(line.score, bestScore);
                color = SETTINGS['color' + capitalize(category)] || '#999';
            }
            const show = isBest ? SETTINGS.showBest : SETTINGS['show' + capitalize(category)];
            if (!show) return;
            anyShown = true;

            const meta = CATEGORY_META[category] || { label: category, icon: '?' };
            const drop = bestScore - line.score;
            const scoreStr = scoreToLabel(line.score);
            const wr = evalToWinrate(line.score);
            const wrStr = Math.round(wr * 100) + '%';

            const row = document.createElement('div');
            row.className = 'cmh-move-item';
            row.style.borderLeftColor = color;
            row.style.color = color;
            row.innerHTML = `
                <span class="cmh-move-badge" style="background:${color};">${meta.icon} ${meta.label}</span>
                <span class="cmh-move-uci" style="color:#e3e1de;">${line.uci}</span>
                <span class="cmh-move-score" title="Score ${scoreStr}, Winrate ${wrStr}">${scoreStr} · ${wrStr}</span>
                <span class="cmh-move-winbar" style="width:${wr * 100}%;color:${color};"></span>
            `;
            listEl.appendChild(row);
        });
        sectionEl.style.display = anyShown ? 'block' : 'none';
        document.getElementById('cmh-empty').style.display = anyShown ? 'none' : 'block';
    }

    // ==================== ARROW DRAWING ====================
    function getBoardInfo() {
        const board = document.querySelector(BOARD_SELECTOR);
        if (!board) return null;
        const bRect = board.getBoundingClientRect();
        if (bRect.width < 10) return null;
        return { board, flipped: board.classList.contains('flipped'), bRect };
    }

    function squareToViewportCoords(square, bRect, flipped) {
        const file = square.charCodeAt(0) - 97;
        const rank = parseInt(square[1], 10) - 1;
        const cellW = bRect.width / 8;
        const cellH = bRect.height / 8;
        let col, row;
        if (!flipped) { col = file; row = 7 - rank; }
        else { col = 7 - file; row = rank; }
        return {
            x: bRect.left + col * cellW + cellW / 2,
            y: bRect.top + row * cellH + cellH / 2,
            cellW, cellH
        };
    }

    let overlaySvg = null;
    function ensureOverlaySvg() {
        if (!overlaySvg || !overlaySvg.parentNode) {
            overlaySvg = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
            overlaySvg.setAttribute('data-chess-overlay', 'best');
            overlaySvg.style.cssText = `
                position: fixed; top: 0; left: 0;
                width: 100vw; height: 100vh;
                pointer-events: none;
                z-index: 2147483647;
                overflow: visible;
            `;
            document.body.appendChild(overlaySvg);
        }
        return overlaySvg;
    }
    function clearOverlay() {
        if (overlaySvg) while (overlaySvg.firstChild) overlaySvg.removeChild(overlaySvg.firstChild);
    }

    function drawArrow(from, to, color, width, opacity, circleRadius) {
        const info = getBoardInfo();
        if (!info) return;
        const svg = ensureOverlaySvg();
        if (from.length !== 2 || to.length !== 2) return;
        const fromCoord = squareToViewportCoords(from, info.bRect, info.flipped);
        const toCoord = squareToViewportCoords(to, info.bRect, info.flipped);

        const glowId = 'glow_' + Math.random().toString(36).slice(2);
        const defs = document.createElementNS('http://www.w3.org/2000/svg', 'defs');
        const filter = document.createElementNS('http://www.w3.org/2000/svg', 'filter');
        filter.setAttribute('id', glowId);
        filter.setAttribute('x', '-50%'); filter.setAttribute('y', '-50%');
        filter.setAttribute('width', '200%'); filter.setAttribute('height', '200%');
        const blur = document.createElementNS('http://www.w3.org/2000/svg', 'feGaussianBlur');
        blur.setAttribute('stdDeviation', '2');
        blur.setAttribute('result', 'coloredBlur');
        const merge = document.createElementNS('http://www.w3.org/2000/svg', 'feMerge');
        const m1 = document.createElementNS('http://www.w3.org/2000/svg', 'feMergeNode'); m1.setAttribute('in', 'coloredBlur');
        const m2 = document.createElementNS('http://www.w3.org/2000/svg', 'feMergeNode'); m2.setAttribute('in', 'SourceGraphic');
        merge.appendChild(m1); merge.appendChild(m2);
        filter.appendChild(blur); filter.appendChild(merge);
        defs.appendChild(filter);
        svg.appendChild(defs);

        const dx = toCoord.x - fromCoord.x;
        const dy = toCoord.y - fromCoord.y;
        const angle = Math.atan2(dy, dx);
        const halfW = width / 2;
        const offsetX = halfW * Math.sin(angle);
        const offsetY = halfW * Math.cos(angle);

        const polygon = document.createElementNS('http://www.w3.org/2000/svg', 'polygon');
        polygon.setAttribute('points', `
            ${fromCoord.x - offsetX},${fromCoord.y + offsetY}
            ${toCoord.x - offsetX},${toCoord.y + offsetY}
            ${toCoord.x + offsetX},${toCoord.y - offsetY}
            ${fromCoord.x + offsetX},${fromCoord.y - offsetY}
        `);
        polygon.setAttribute('fill', color);
        polygon.setAttribute('opacity', String(opacity));
        polygon.setAttribute('filter', `url(#${glowId})`);
        svg.appendChild(polygon);

        const circleStart = document.createElementNS('http://www.w3.org/2000/svg', 'circle');
        circleStart.setAttribute('cx', String(fromCoord.x));
        circleStart.setAttribute('cy', String(fromCoord.y));
        circleStart.setAttribute('r', String(halfW));
        circleStart.setAttribute('fill', color);
        circleStart.setAttribute('opacity', String(opacity));
        circleStart.setAttribute('filter', `url(#${glowId})`);
        svg.appendChild(circleStart);

        const circleEnd = document.createElementNS('http://www.w3.org/2000/svg', 'circle');
        circleEnd.setAttribute('cx', String(toCoord.x));
        circleEnd.setAttribute('cy', String(toCoord.y));
        circleEnd.setAttribute('r', String(circleRadius));
        circleEnd.setAttribute('fill', color);
        circleEnd.setAttribute('opacity', String(opacity));
        circleEnd.setAttribute('filter', `url(#${glowId})`);
        svg.appendChild(circleEnd);
    }

    function drawAllArrows(lines) {
        clearOverlay();
        if (!lines || lines.length === 0) return;
        const bestScore = lines[0].score;
        const ordered = [...lines].sort((a, b) => a.score - b.score);
        ordered.forEach((line) => {
            const isBest = line.uci === lines[0].uci;
            const from = line.uci.substring(0, 2);
            const to = line.uci.substring(2, 4);
            let color, width, opacity, circleRadius, show;
            if (isBest) {
                color = SETTINGS.bestColor;
                width = SETTINGS.bestLineWidth;
                opacity = SETTINGS.bestOpacity;
                circleRadius = SETTINGS.bestCircleRadius;
                show = SETTINGS.showBest;
            } else {
                const cat = classifyMove(line.score, bestScore);
                color = SETTINGS['color' + capitalize(cat)] || '#999';
                width = SETTINGS.multiLineWidth;
                opacity = SETTINGS.multiLineOpacity;
                circleRadius = SETTINGS.multiCircleRadius;
                show = SETTINGS['show' + capitalize(cat)];
            }
            if (!show) return;
            drawArrow(from, to, color, width, opacity, circleRadius);
        });
    }

    function redrawAllArrows() {
        if (lastLines && lastLines.length > 0) drawAllArrows(lastLines);
    }

    // ==================== SIMULATION UTILS ====================
    function sleep(ms) { return new Promise(r => setTimeout(r, ms)); }

    function gaussian(mean = 0, stdDev = 1) {
        let u = 0, v = 0;
        while (u === 0) u = Math.random();
        while (v === 0) v = Math.random();
        return mean + stdDev * Math.sqrt(-2 * Math.log(u)) * Math.cos(2 * Math.PI * v);
    }

    function reactionTimeSample() {
        const min = SETTINGS.reactionTimeMin;
        const max = SETTINGS.reactionTimeMax;
        const median = (min + max) / 2;
        const sigma = 0.45;
        const mu = Math.log(Math.max(50, median));
        let t = Math.exp(mu + sigma * gaussian(0, 1));
        return Math.max(min, Math.min(max * 1.2, t));
    }

    function jitter(maxCell) {
        if (!SETTINGS.autoMoveHumanize) return { x: 0, y: 0 };
        const scale = SETTINGS.jitterScale;
        if (scale <= 0) return { x: 0, y: 0 };
        const maxJitter = maxCell * scale;
        const sigma = maxJitter * 0.4;
        const x = Math.max(-maxJitter, Math.min(maxJitter, gaussian(0, sigma)));
        const y = Math.max(-maxJitter, Math.min(maxJitter, gaussian(0, sigma)));
        return { x, y };
    }

    function firePointer(target, type, x, y, opts = {}) {
        const base = {
            bubbles: true, cancelable: true, composed: true,
            clientX: x, clientY: y, screenX: x, screenY: y,
            button: 0, buttons: type === 'pointerdown' || type === 'pointermove' ? 1 : 0,
            pointerId: 1, pointerType: 'mouse', isPrimary: true,
            view: window, ...opts
        };
        try { target.dispatchEvent(new PointerEvent(type, base)); }
        catch (e) { target.dispatchEvent(new MouseEvent(type.replace('pointer', 'mouse'), base)); }
    }
    function fireMouse(target, type, x, y) {
        target.dispatchEvent(new MouseEvent(type, {
            bubbles: true, cancelable: true, composed: true,
            clientX: x, clientY: y, screenX: x, screenY: y,
            button: 0, buttons: type === 'mousedown' || type === 'mousemove' ? 1 : 0,
            view: window
        }));
    }

    // ==================== SIMULATE DRAG (v1.7 proven method) ====================
    async function simulateDragDrop(startX, startY, endX, endY, cellW, cellH) {
        const humanize = SETTINGS.autoMoveHumanize;
        const maxCell = Math.min(cellW, cellH);
        const startEl = document.elementFromPoint(startX, startY);
        if (!startEl) throw new Error('no element at start');

        const j0 = jitter(maxCell);
        const sx = startX + j0.x;
        const sy = startY + j0.y;
        let startTarget = document.elementFromPoint(sx, sy) || startEl;

        firePointer(startTarget, 'pointerdown', sx, sy);
        fireMouse(startTarget, 'mousedown', sx, sy);
        await sleep(humanize ? 40 + Math.random() * 40 : 20);

        const steps = humanize ? 14 + Math.floor(Math.random() * 6) : 10;
        const curveOffset = humanize ? (Math.random() - 0.5) * maxCell * 0.4 : 0;
        const perpX = -(endY - startY);
        const perpY = (endX - startX);
        const perpLen = Math.hypot(perpX, perpY) || 1;
        const midOffsetX = (perpX / perpLen) * curveOffset;
        const midOffsetY = (perpY / perpLen) * curveOffset;
        const pauseAt = humanize ? Math.floor(steps * (0.4 + Math.random() * 0.2)) : -1;

        for (let i = 1; i <= steps; i++) {
            const t = i / steps;
            const curveAmount = Math.sin(t * Math.PI);
            const x = startX + (endX - startX) * t + midOffsetX * curveAmount;
            const y = startY + (endY - startY) * t + midOffsetY * curveAmount;
            const jm = humanize ? jitter(maxCell * 0.2) : { x: 0, y: 0 };
            const px = x + jm.x;
            const py = y + jm.y;
            const target = document.elementFromPoint(px, py) || startEl;
            firePointer(target, 'pointermove', px, py);
            fireMouse(target, 'mousemove', px, py);
            let stepDelay = humanize ? 10 + Math.random() * 18 : 8;
            if (i === pauseAt) stepDelay += humanize ? 40 + Math.random() * 80 : 0;
            await sleep(stepDelay);
        }

        await sleep(humanize ? 50 + Math.random() * 60 : 25);
        const endTarget = document.elementFromPoint(endX, endY) || startEl;
        firePointer(endTarget, 'pointerup', endX, endY);
        fireMouse(endTarget, 'mouseup', endX, endY);
        fireMouse(endTarget, 'click', endX, endY);
    }

    // ==================== SIMULATE CLICK-CLICK ====================
    async function simulateClickClick(startX, startY, endX, endY, cellW, cellH) {
        const humanize = SETTINGS.autoMoveHumanize;
        const maxCell = Math.min(cellW, cellH);
        const startEl = document.elementFromPoint(startX, startY);
        if (!startEl) throw new Error('no element at start');

        const j1 = jitter(maxCell);
        const s1x = startX + j1.x;
        const s1y = startY + j1.y;
        const s1El = document.elementFromPoint(s1x, s1y) || startEl;

        firePointer(s1El, 'pointerdown', s1x, s1y);
        fireMouse(s1El, 'mousedown', s1x, s1y);
        await sleep(humanize ? 30 + Math.random() * 30 : 15);
        firePointer(s1El, 'pointerup', s1x, s1y);
        fireMouse(s1El, 'mouseup', s1x, s1y);
        fireMouse(s1El, 'click', s1x, s1y);

        if (humanize) {
            const hoverSteps = 6 + Math.floor(Math.random() * 4);
            for (let i = 1; i <= hoverSteps; i++) {
                const t = i / hoverSteps;
                const x = startX + (endX - startX) * t;
                const y = startY + (endY - startY) * t;
                const target = document.elementFromPoint(x, y) || startEl;
                firePointer(target, 'pointermove', x, y);
                fireMouse(target, 'mousemove', x, y);
                await sleep(12 + Math.random() * 15);
            }
        }
        await sleep(humanize ? reactionTimeSample() * 0.4 : 80);

        const j2 = jitter(maxCell);
        const e2x = endX + j2.x;
        const e2y = endY + j2.y;
        const e2El = document.elementFromPoint(e2x, e2y) || startEl;

        firePointer(e2El, 'pointerdown', e2x, e2y);
        fireMouse(e2El, 'mousedown', e2x, e2y);
        await sleep(humanize ? 25 + Math.random() * 30 : 12);
        firePointer(e2El, 'pointerup', e2x, e2y);
        fireMouse(e2El, 'mouseup', e2x, e2y);
        fireMouse(e2El, 'click', e2x, e2y);
    }

    // ==================== SMART AUTO MOVE ====================
    async function maybeAutoMoveSmart(lines, side) {
        const autoMoveBox = document.getElementById('cmh-auto-move');
        if (!autoMoveBox || !autoMoveBox.checked) return;
        if (!IS_ANALYSIS && !isAutoOutsideAnalysisAllowed()) return;
        const info = getBoardInfo();
        if (!info) return;
        if (!lines || lines.length === 0) return;

        const bestScore = lines[0].score;
        const candidates = lines.map((line, i) => {
            const category = i === 0 ? 'best' : classifyMove(line.score, bestScore);
            return { uci: line.uci, score: line.score, category, winrate: evalToWinrate(line.score), isBest: i === 0 };
        });
        const chosen = pickMoveWeighted(candidates);
        if (!chosen) return;

        const chosenEl = document.getElementById('cmh-chosen');
        if (chosenEl) {
            chosenEl.classList.remove('hidden');
            const catLabel = chosen.isBest ? 'BEST' : chosen.category.toUpperCase();
            const strat = SETTINGS.autoMoveStrategy;
            chosenEl.innerHTML = `→ Playing <strong style="color:#fff">${chosen.uci}</strong> [${catLabel}] · WR ${(chosen.winrate * 100).toFixed(0)}% · <em style="font-style:normal;color:#b08a52;">${strat}</em>`;
        }

        const uci = chosen.uci;
        const from = uci.substring(0, 2);
        const to = uci.substring(2, 4);
        const fromCoord = squareToViewportCoords(from, info.bRect, info.flipped);
        const toCoord = squareToViewportCoords(to, info.bRect, info.flipped);

        let totalDelay = SETTINGS.autoMoveDelay;
        if (SETTINGS.autoMoveHumanize) totalDelay += reactionTimeSample() * 0.5;
        if (totalDelay > 0) {
            setStatus(`Auto-move in ${Math.round(totalDelay)}ms → ${uci}`, 'warn');
            await sleep(totalDelay);
        }

        setStatus(`Auto-moving (${SETTINGS.autoMoveMode}) → ${uci}`, 'loading');
        try {
            if (SETTINGS.autoMoveMode === 'click') {
                await simulateClickClick(fromCoord.x, fromCoord.y, toCoord.x, toCoord.y, fromCoord.cellW, fromCoord.cellH);
            } else {
                await simulateDragDrop(fromCoord.x, fromCoord.y, toCoord.x, toCoord.y, fromCoord.cellW, fromCoord.cellH);
            }
            setStatus(`Auto-move done → ${uci}`, 'ok');
            showToast(`✓ Played ${uci}`, 'ok');
        } catch (e) {
            setStatus('Auto-move failed: ' + e.message, 'error');
            showToast('✗ Auto-move failed', 'err');
            console.error(e);
        }
    }

    // ==================== OBSERVER ====================
    let debounceTimer = null;
    let lastKnownMoveCount = -1;
    let lastKnownLastMove = '';
    let pollTimer = null;
    let moveListObserver = null;
    let bodyObserver = null;

    function getMoveSnapshot() {
        const list = document.querySelector(OBSERVE_ROOT_SELECTOR);
        if (!list) return { count: 0, last: '' };
        const nodes = list.querySelectorAll('[data-node]');
        const count = nodes.length;
        let last = '';
        if (count > 0) last = normalizeSan(extractSanFromNode(nodes[count - 1]));
        return { count, last };
    }

    function scheduleAnalyze(reason) {
        const auto = document.getElementById('cmh-auto-mode');
        if (!auto || !auto.checked) return;
        clearTimeout(debounceTimer);
        debounceTimer = setTimeout(() => {
            const snap = getMoveSnapshot();
            if (snap.count === lastKnownMoveCount && snap.last === lastKnownLastMove) return;
            lastKnownMoveCount = snap.count;
            lastKnownLastMove = snap.last;
            // Retry detect kalau belum berhasil & belum override
            if (!userOverrideSide && !detectedSide) {
                tryDetectSide();
            }
            analyze();
        }, DEBOUNCE_MS);
    }

    function attachMoveListObserver() {
        const target = document.querySelector(OBSERVE_ROOT_SELECTOR);
        if (!target) return false;
        if (moveListObserver) moveListObserver.disconnect();
        moveListObserver = new MutationObserver((mutations) => {
            for (const m of mutations) {
                if (m.type === 'childList') {
                    for (const n of m.addedNodes) {
                        if (n.nodeType === Node.ELEMENT_NODE) {
                            if (n.hasAttribute && n.hasAttribute('data-node')) { scheduleAnalyze('node-added'); return; }
                            if (n.querySelector && n.querySelector('[data-node]')) { scheduleAnalyze('node-added-nested'); return; }
                        }
                    }
                    for (const n of m.removedNodes) {
                        if (n.nodeType === Node.ELEMENT_NODE && n.hasAttribute && n.hasAttribute('data-node')) { scheduleAnalyze('node-removed'); return; }
                    }
                } else if (m.type === 'characterData') {
                    const parent = m.target.parentElement;
                    if (parent && parent.closest('[data-node]')) { scheduleAnalyze('text-changed'); return; }
                }
            }
        });
        moveListObserver.observe(target, { childList: true, subtree: true, characterData: true });
        return true;
    }

    function attachBodyObserver() {
        if (bodyObserver) bodyObserver.disconnect();
        bodyObserver = new MutationObserver((mutations) => {
            for (const m of mutations) {
                for (const n of m.addedNodes) {
                    if (n.nodeType === Node.ELEMENT_NODE) {
                        if (n.matches && n.matches(OBSERVE_ROOT_SELECTOR)) {
                            attachMoveListObserver();
                            scheduleAnalyze('list-replaced');
                            return;
                        }
                        if (n.querySelector && n.querySelector(OBSERVE_ROOT_SELECTOR)) {
                            attachMoveListObserver();
                            scheduleAnalyze('list-added');
                            return;
                        }
                    }
                }
            }
        });
        bodyObserver.observe(document.body, { childList: true, subtree: true });
    }

    function startPolling() {
        if (pollTimer) clearInterval(pollTimer);
        pollTimer = setInterval(() => {
            const auto = document.getElementById('cmh-auto-mode');
            if (!auto || !auto.checked) return;
            const snap = getMoveSnapshot();
            if (snap.count !== lastKnownMoveCount || snap.last !== lastKnownLastMove) scheduleAnalyze('poll');
            const current = document.querySelector(OBSERVE_ROOT_SELECTOR);
            if (current && !moveListObserver) attachMoveListObserver();
            // Retry detect kalau belum berhasil
            if (!userOverrideSide && !detectedSide && detectionAttempts < MAX_DETECTION_ATTEMPTS) {
                tryDetectSide();
            }
        }, 1000);
    }

    function startObservers() {
        const tryAttach = () => {
            if (attachMoveListObserver()) {
                attachBodyObserver();
                startPolling();
                scheduleAnalyze('initial');
                // Trigger detection saat move list ready
                setTimeout(tryDetectSide, 300);
                setTimeout(tryDetectSide, 1500);
            } else {
                setTimeout(tryAttach, 500);
            }
        };
        tryAttach();
    }
    startObservers();

    // ==================== INIT ====================
    const savedOnLoad = loadState();
    if (savedOnLoad) {
        setStatus(`Loaded saved state: ${savedOnLoad.moves.length} moves.`, 'ok');
    }

})();
