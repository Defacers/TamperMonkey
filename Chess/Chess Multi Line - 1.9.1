    // ==================== PANEL ====================
    function createPanel() {
        if (!document.body) { setTimeout(createPanel, 500); return; }
        if (document.getElementById('cmh-panel')) return;

        const panel = document.createElement('div');
        panel.id = 'cmh-panel';

        const saved = localStorage.getItem(PANEL_POS_KEY);
        if (saved) {
            try {
                const { x, y } = JSON.parse(saved);
                panel.style.left = x + 'px';
                panel.style.top = y + 'px';
            } catch (e) {}
        }

        const autoOutsideAllowed = isAutoOutsideAnalysisAllowed();
        const autoMoveDisabled = !IS_ANALYSIS && !autoOutsideAllowed;
        const collapsed = localStorage.getItem(PANEL_COLLAPSED_KEY) === '1';

