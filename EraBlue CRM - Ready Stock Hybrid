                document.createElement('div');

            card.className =
                'eb-ready-card';

            const total =
                item.stores.reduce(
                    (sum, store) =>
                        sum +
                        Number(
                            store.stock || 0
                        ),
                    0
                );

            card.innerHTML = `
                <div
                    class="eb-ready-product"
                    title="${escapeHTML(item.name)}"
                >
                    ${escapeHTML(item.name)}
                </div>

                <div class="eb-ready-sku">
                    ${escapeHTML(item.sku)}
                </div>

                <div class="eb-ready-info">
                    <div class="eb-ready-stock">
                        ${total}
                        <small>stock</small>
                    </div>

                    <div class="eb-ready-store-count">
                        ${item.stores.length} TOKO
                    </div>
                </div>

                <div class="eb-ready-store-list"></div>
            `;

            const storeList =
                card.querySelector(
                    '.eb-ready-store-list'
                );

            [...item.stores]
                .sort(
                    (a, b) =>
                        b.stock - a.stock
                )
                .forEach(store => {
                    const storeRow =
                        document.createElement('div');

                    storeRow.className =
                        'eb-ready-store-row';

                    storeRow.innerHTML = `
                        <span
                            class="eb-ready-store-name"
                            title="${escapeHTML(store.name)}"
                        >
                            ${escapeHTML(store.name)}
                        </span>

                        <span
                            class="eb-ready-store-qty"
                        >
                            ${store.stock}
                        </span>
                    `;

                    /*
                     * =================================================
                     * PENTING:
                     * NAMA TOKO SEKARANG JUGA KLIK QTY ASLI CRM.
                     * Tidak lagi hanya scroll ke row.
                     * =================================================
                     */
                    storeRow.addEventListener(
                        'click',
                        function(event) {
                            event.preventDefault();
                            event.stopPropagation();

                            clickOriginalQty(
                                store,
                                item.row
                            );
                        }
                    );

                    storeList.appendChild(
                        storeRow
                    );
                });

            /*
             * Klik card/product/SKU juga menuju
             * row asli CRM.
             */
            card.addEventListener(
                'click',
                function(event) {
                    if (
                        event.target.closest(
                            '.eb-ready-store-row'
                        )
                    ) {
                        return;
                    }

                    jumpToRow(item.row);
                }
            );

            list.appendChild(card);
        });
    }

