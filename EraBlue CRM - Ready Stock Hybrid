                                        product.store,
                                        product.item.row
                                    );
                                }
                            );

                        /*
                         * Angka stock tetap bisa diklik.
                         */
                        productRow
                            .querySelector(
                                '.eb-store-product-qty'
                            )
                            .addEventListener(
