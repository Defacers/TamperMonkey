    // =========================================================
    // RENDER
    // =========================================================

    function render() {
        const panel =
            document.getElementById(
                CONFIG.panelId
            );

        if (!panel) return;

        const list =
            document.getElementById(
                'ebReadyList'
            );

        const count =
            document.getElementById(
                'ebReadyCount'
            );

        if (!list || !count) return;

        const items =
            getFilteredItems();

        count.textContent = items.length;

        panel.classList.remove(
            'eb-view-sku',
            'eb-view-store'
        );

        panel.classList.add(
            currentView === 'sku'
                ? 'eb-view-sku'
                : 'eb-view-store'
        );

        if (!items.length) {
            list.innerHTML = `
                <div class="eb-ready-empty">
                    ${
                        currentSearch
                            ? 'Tidak ada data yang cocok dengan filter.'
                            : 'Tidak ada barang ready di halaman CRM.'
                    }
                </div>
            `;
            return;
        }

        if (currentView === 'sku') {
            renderSKU(list, items);
        } else {
            renderStore(list, items);
        }
    }

