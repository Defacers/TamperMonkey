    // =========================================================
    // TABLE SIGNATURE
    // =========================================================

    function getTableSignature(table) {
        if (!table) return '';

        const rows =
            table.querySelectorAll(
                'tbody tr'
            );

        let result = '';

        /*
         * Signature dibuat ringan tetapi cukup untuk mendeteksi:
         * - pagination
         * - search
         * - perubahan stock
         * - perubahan SKU
         * - perubahan toko
         */
        rows.forEach(row => {
            result += '|';

            const header =
                row.querySelector(
                    'th.row-header'
                );

            if (header) {
                result +=
                    header.textContent
                        .replace(/\s+/g, ' ')
                        .trim();
            }

            row.querySelectorAll('td')
                .forEach(cell => {
                    result += '§';
                    result +=
                        cell.className || '';
                    result += ':';
                    result +=
                        cell.textContent
                            .replace(/\s+/g, ' ')
                            .trim();
                });
        });

        return result;
    }

    // =========================================================
    // SCHEDULE SCAN
    // =========================================================

    function scheduleScan(delay = CONFIG.scanDelay) {
        clearTimeout(scanTimer);

        scanTimer = setTimeout(
            function() {
                const table =
                    document.querySelector(
                        CONFIG.tableSelector
                    );

                if (table !== currentTable) {
                    bindTableObserver(table);
                }

                scanTable();
            },
            delay
        );
    }

    // =========================================================
    // TABLE OBSERVER
    // =========================================================

    function bindTableObserver(table) {
        if (tableObserver) {
            tableObserver.disconnect();
            tableObserver = null;
        }

        currentTable = table || null;
        lastSignature = '';

        if (!table) {
            inventoryData = [];
            render();
            return;
        }

        tableObserver =
            new MutationObserver(
                function(mutations) {
                    let relevant = false;

                    for (const mutation of mutations) {
                        if (
                            mutation.type ===
                                'childList' ||
                            mutation.type ===
                                'characterData'
                        ) {
                            relevant = true;
                            break;
                        }
                    }

                    if (relevant) {
                        scheduleScan(120);
                    }
                }
            );

        tableObserver.observe(
            table,
            {
                childList: true,
                subtree: true,
                characterData: true
            }
        );
    }

    // =========================================================
    // GLOBAL WATCHER
    // =========================================================

    function installGlobalWatcher() {
        if (bodyObserver) {
            bodyObserver.disconnect();
        }

        /*
         * BODY observer:
         * menangkap table yang diganti/re-render.
         */
        bodyObserver =
            new MutationObserver(
                function(mutations) {
                    let relevant = false;

                    for (const mutation of mutations) {
                        const target =
                            mutation.target instanceof Element
                                ? mutation.target
                                : mutation.target.parentElement;

                        /*
                         * Abaikan perubahan dari panel sendiri.
                         */
                        if (
                            target &&
                            target.closest &&
                            target.closest(
                                `#${CONFIG.panelId}`
                            )
                        ) {
                            continue;
                        }

                        if (
                            mutation.type ===
                                'childList' ||
                            mutation.type ===
                                'characterData'
                        ) {
                            relevant = true;
                            break;
                        }
                    }

                    if (!relevant) return;

                    const table =
                        document.querySelector(
                            CONFIG.tableSelector
                        );

                    if (table !== currentTable) {
                        bindTableObserver(table);
                        scheduleScan(50);
                        return;
                    }

                    scheduleScan(120);
                }
            );

        bodyObserver.observe(
            document.body,
            {
                childList: true,
                subtree: true,
                characterData: true
            }
        );

        /*
         * Search/filter CRM.
         */
        document.addEventListener(
            'input',
            function(event) {
                if (
                    event.target &&
                    event.target.closest &&
                    event.target.closest(
                        `#${CONFIG.panelId}`
                    )
                ) {
                    return;
                }

                scheduleScan(100);
            },
            true
        );

        document.addEventListener(
            'change',
            function(event) {
                if (
                    event.target &&
                    event.target.closest &&
                    event.target.closest(
                        `#${CONFIG.panelId}`
                    )
                ) {
                    return;
                }

                scheduleScan(100);
            },
            true
        );

        /*
         * Pagination / tab / filter CRM yang hanya berubah
         * setelah klik.
         */
        document.addEventListener(
            'click',
            function(event) {
                if (
                    event.target &&
                    event.target.closest &&
                    event.target.closest(
                        `#${CONFIG.panelId}`
                    )
                ) {
                    return;
                }

                scheduleScan(250);
            },
            true
        );

        /*
         * Keyboard search / pagination.
         */
        document.addEventListener(
            'keyup',
            function(event) {
                if (
                    event.target &&
                    event.target.closest &&
                    event.target.closest(
                        `#${CONFIG.panelId}`
                    )
                ) {
                    return;
                }

                scheduleScan(250);
            },
            true
        );

        /*
         * History API untuk CRM SPA.
         */
        if (!history.__ebReadyStockPatched) {
            const originalPushState =
                history.pushState;

            const originalReplaceState =
                history.replaceState;

            history.pushState =
                function() {
                    const result =
                        originalPushState.apply(
                            this,
                            arguments
                        );

                    setTimeout(
                        () => scheduleScan(50),
                        0
                    );

                    return result;
                };

            history.replaceState =
                function() {
                    const result =
                        originalReplaceState.apply(
                            this,
                            arguments
                        );

                    setTimeout(
                        () => scheduleScan(50),
                        0
                    );

                    return result;
                };

            history.__ebReadyStockPatched =
                true;

            window.addEventListener(
                'popstate',
                () => scheduleScan(50)
            );
        }

        /*
         * Safety watcher:
         * tetap mengecek setiap 1 detik untuk kasus CRM
         * mengubah data tanpa mutation event yang terlihat.
         */
        clearInterval(tableWatchTimer);

        tableWatchTimer =
            setInterval(
                function() {
                    const table =
                        document.querySelector(
                            CONFIG.tableSelector
                        );

                    if (table !== currentTable) {
                        bindTableObserver(table);
                        scheduleScan(0);
                        return;
                    }

                    if (!table) {
                        if (
                            inventoryData.length
                        ) {
                            inventoryData = [];
                            render();
                        }

                        return;
                    }

                    const signature =
                        getTableSignature(
                            table
                        );

                    if (
                        signature !==
                        lastSignature
                    ) {
                        lastSignature =
                            signature;

                        scheduleScan(80);
                    }
                },
                1000
            );
    }

    // =========================================================
    // WAIT CRM
    // =========================================================

    function waitForCRM() {
        /*
         * Jangan tunggu #tbInventory.
         * Panel + API controls harus hidup walaupun CRM table belum render.
         */
        start();
    }

    // =========================================================
    // START
    // =========================================================

    function start() {
        injectCSS();
        createPanel();

        const table =
            document.querySelector(
                CONFIG.tableSelector
            );

        currentTable = table || null;

        bindTableObserver(table);

        scanTable();

        installGlobalWatcher();

        /*
         * AJAX/DataTables initial rendering.
         */
        setTimeout(
            () => scanTable(),
            300
        );

        setTimeout(
            () => scanTable(),
            1000
        );

        setTimeout(
            () => scanTable(),
            2500
        );

        setTimeout(
            () => scanTable(),
            5000
        );
    }

    // =========================================================
    // INIT
    // =========================================================

    if (
        document.readyState ===
        'loading'
    ) {
        document.addEventListener(
            'DOMContentLoaded',
            waitForCRM,
            { once: true }
        );
    } else {
        waitForCRM();
    }

