        function syncStatusDropdown() {
            const selectedOption = statusSelect.options[statusSelect.selectedIndex];
            statusTrigger.textContent = selectedOption ? selectedOption.text : 'Pilih status';
            statusOptions.querySelectorAll('.eb-api-option').forEach(option => {
                const selected = option.dataset.value === statusSelect.value;
                option.classList.toggle('selected', selected);
