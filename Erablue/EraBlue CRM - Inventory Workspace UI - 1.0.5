    // =========================================================
    // BASIC HELPERS
    // =========================================================

    function injectCSS() {
        if (document.getElementById('ebReadyStockCSS')) return;

        const style = document.createElement('style');
        style.id = 'ebReadyStockCSS';
        style.textContent = css;
        document.head.appendChild(style);
    }

    function escapeHTML(value) {
        return String(value || '')
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;')
            .replace(/'/g, '&#039;');
    }

    function getNumber(text) {
        if (!text) return 0;

        const value = String(text)
            .split('(')[0]
            .trim();

        const match = value.match(/-?\d+(?:[.,]\d+)?/);

        if (!match) return 0;

        const number = parseFloat(
            match[0].replace(',', '.')
        );

        return Number.isFinite(number) ? number : 0;
    }

    // =========================================================
    // PRODUCT
    // =========================================================

    function getProductName(row) {
        const header = row.querySelector('th.row-header');

        if (!header) {
            return {
                name: 'Unknown Product',
                sku: ''
            };
        }

        const link = header.querySelector('a');

        let name = link
            ? link.textContent.trim()
            : header.textContent.trim();

        const skuElement = header.querySelector('b');

        const sku = skuElement
            ? skuElement.textContent.trim()
            : '';

        name = name
            .replace(/\s+/g, ' ')
            .trim();

        return {
            name,
            sku
        };
    }

    // =========================================================
    // STORE
    // =========================================================

    function getStoreInfo(cell) {
        if (!cell) return null;

        const classes = [...cell.classList];

        const storeCode = classes.find(
            c => /^\d+$/.test(c)
        );

        if (!storeCode) return null;

        let unitLink = null;

        try {
            unitLink = document.querySelector(
                `${CONFIG.tableSelector} a#ST${CSS.escape(String(storeCode))}`
            );
        } catch (e) {
            unitLink = null;
        }

        let name = storeCode;

        if (unitLink) {
            name = unitLink.textContent
                .replace(/\s+/g, ' ')
                .trim();

            name = name.replace(
                new RegExp(
                    '^' +
                    storeCode +
                    '\\s*-\\s*',
                    'i'
                ),
                ''
            );
        }

        return {
            code: storeCode,
            name,
            unitLink
        };
    }

    // =========================================================
    // FIND ORIGINAL CRM CLICK TARGET
    // =========================================================

    function findClickableQty(cell, stock) {
        if (!cell) return null;

        const candidates = cell.querySelectorAll(
            'a,button,[role="button"],[onclick],span,div'
        );

        for (const element of candidates) {
            const text = element.textContent.trim();

            if (!text || text.length > 30) continue;

            const number = getNumber(text);

            if (number !== stock) continue;

            let clickable = element.matches(
                'a,button,[role="button"],[onclick]'
            );

            if (!clickable) {
                try {
                    clickable =
                        window.getComputedStyle(element).cursor === 'pointer';
                } catch (e) {
                    clickable = false;
                }
            }

            if (clickable) return element;
        }

        const links = cell.querySelectorAll('a');

        for (const link of links) {
            if (
                getNumber(link.textContent) === stock
            ) {
                return link;
            }
        }

        return cell;
    }

    // =========================================================
    // SCAN TABLE
    // =========================================================

    function scanTable() {
        const table = document.querySelector(
            CONFIG.tableSelector
        );

        /*
         * Kalau table hilang sementara karena pagination/AJAX,
         * langsung kosongkan data agar tidak menampilkan data lama.
         */
        if (!table) {
            inventoryData = [];
            render();
            currentTable = null;
            return false;
        }

        if (table !== currentTable) {
            bindTableObserver(table);
        }

        const rows = table.querySelectorAll(
            'tbody tr'
        );

        if (!rows.length) {
            inventoryData = [];
            render();
            return false;
        }

        const readyItems = [];

        rows.forEach(row => {
            const header = row.querySelector(
                'th.row-header'
            );

            if (!header) return;

            const cells = row.querySelectorAll('td');

            if (!cells.length) return;

            const product = getProductName(row);

            const readyStores = [];
            let hasExcludedStock = false;

            let totalStock = 0;

            cells.forEach((cell, index) => {
                /*
                 * Cell pertama = total.
                 */
                if (index === 0) return;

                const stock = getNumber(
                    cell.textContent
                );

                if (excludeHighStock && stock >= CONFIG.excludeStockAtOrAbove) {
                    hasExcludedStock = true;
                    return;
                }
                if (stock <= 0) return;

                const store = getStoreInfo(cell);

                if (!store) return;

                const qtyElement =
                    findClickableQty(
                        cell,
                        stock
                    );

                totalStock += stock;

                readyStores.push({
                    code: store.code,
                    name: store.name,
                    stock,
                    qtyCell: cell,
                    qtyElement,
                    unitLink: store.unitLink
                });
            });

            const displayedTotal = getNumber(
                cells[0].textContent
            );

            if (
                displayedTotal > 0 &&
                (!excludeHighStock || displayedTotal < CONFIG.excludeStockAtOrAbove) &&
                totalStock === 0
            ) {
                totalStock = displayedTotal;
            }

            row.classList.remove(
                'eb-ready-row'
            );

            if (
                (!excludeHighStock || !hasExcludedStock) &&
                totalStock >= CONFIG.minStock &&
                (!excludeHighStock || totalStock < CONFIG.excludeStockAtOrAbove)
            ) {
                row.classList.add(
                    'eb-ready-row'
                );

                readyItems.push({
                    row,
                    name: product.name,
                    sku: product.sku,
                    total: totalStock,
                    stores: readyStores
                });
            }
        });

        inventoryData = readyItems;

        lastSignature = getTableSignature(table);

        render();

        return true;
    }

    // =========================================================
    // SEARCH
    // =========================================================

    function getTokens() {
        return String(currentSearch || '')
            .split(',')
            .map(x =>
                x
                    .toLowerCase()
                    .replace(/\s+/g, ' ')
                    .trim()
            )
            .filter(Boolean);
    }

    function textMatch(value, token) {
        return String(value || '')
            .toLowerCase()
            .replace(/\s+/g, ' ')
            .includes(token);
    }

    function getFilteredItems() {
        const tokens = getTokens();

        if (!tokens.length) {
            return inventoryData;
        }

        return inventoryData
            .map(item => {
                const productMatched =
                    tokens.some(token =>
                        textMatch(
                            item.name,
                            token
                        ) ||
                        textMatch(
                            item.sku,
                            token
                        )
                    );

                const matchedStores =
                    item.stores.filter(store =>
                        tokens.some(token =>
                            textMatch(
                                store.name,
                                token
                            ) ||
                            textMatch(
                                store.code,
                                token
                            )
                        )
                    );

                if (
                    !productMatched &&
                    matchedStores.length === 0
                ) {
                    return null;
                }

                const hasStoreFilter =
                    matchedStores.length > 0;

                return {
                    ...item,
                    stores: hasStoreFilter
                        ? matchedStores
                        : item.stores
                };
            })
            .filter(Boolean)
            .filter(
                item => item.stores.length > 0
            );
    }

    // =========================================================
    // FIND CURRENT ORIGINAL TARGET
    // =========================================================

    function findCurrentQtyTarget(row, store) {
        if (!row || !store) return null;

        const cells = row.querySelectorAll('td');

        for (const cell of cells) {
            const info = getStoreInfo(cell);

            if (!info) continue;

            if (
                String(info.code) !==
                String(store.code)
            ) {
                continue;
            }

            const stock = getNumber(
                cell.textContent
            );

            /*
             * Jangan terlalu bergantung pada angka stock.
             * Kalau DOM berubah dan qty masih ada, tetap gunakan
             * cell toko yang benar.
             */
            if (
                stock === Number(store.stock)
            ) {
                return findClickableQty(
                    cell,
                    stock
                );
            }

            /*
             * Fallback jika angka berubah setelah refresh.
             */
            const target =
                findClickableQty(
                    cell,
                    stock
                );

            if (target) return target;
        }

        return null;
    }

    // =========================================================
    // CLICK ORIGINAL CRM
    // =========================================================

    function clickOriginalQty(store, row) {
        let target = null;

        if (
            store &&
            store.qtyElement &&
            document.contains(store.qtyElement)
        ) {
            target = store.qtyElement;
        }

        /*
         * DOM mungkin sudah diganti CRM.
         */
        if (!target) {
            target = findCurrentQtyTarget(
                row,
                store
            );
        }

        /*
         * Kalau belum ketemu, scan terbaru lalu cari lagi.
         */
        if (!target && row) {
            scanTable();

            target = findCurrentQtyTarget(
                row,
                store
            );
        }

        if (!target) {
            jumpToRow(row);
            return;
        }

        try {
            target.scrollIntoView({
                behavior: 'smooth',
                block: 'center',
                inline: 'center'
            });
        } catch (e) {}

        const oldBg = target.style.background;
        const oldShadow = target.style.boxShadow;

        target.style.background =
            'rgba(34,197,94,.45)';

        target.style.boxShadow =
            '0 0 0 2px rgba(34,197,94,.5)';

        setTimeout(() => {
            try {
                target.click();
            } catch (e) {
                try {
                    target.dispatchEvent(
                        new MouseEvent(
                            'click',
                            {
                                bubbles: true,
                                cancelable: true,
                                view: window
                            }
                        )
                    );
                } catch (e2) {}
            }
        }, 80);

        setTimeout(() => {
            try {
                target.style.background = oldBg;
                target.style.boxShadow = oldShadow;
            } catch (e) {}
        }, 900);
    }

    // =========================================================
    // JUMP ROW
    // =========================================================

    function jumpToRow(row) {
        if (!row) return;

        try {
            row.scrollIntoView({
                behavior: 'smooth',
                block: 'center'
            });
        } catch (e) {}
    }

    // =========================================================
    // SKU VIEW
    // =========================================================

    function renderSKU(list, items) {
        list.innerHTML = '';

        items.forEach(item => {
            const card =
                document.createElement('div');

            card.className =
                'eb-ready-card';

            const total =
                item.stores.reduce(
                    (sum, store) =>
                        sum +
                        Number(
                            store.stock || 0
                        ),
                    0
                );

            card.innerHTML = `
                <div
                    class="eb-ready-product"
                    title="${escapeHTML(item.name)}"
                >
                    ${escapeHTML(item.name)}
                </div>

                <div class="eb-ready-sku">
                    ${escapeHTML(item.sku)}
                </div>

                <div class="eb-ready-info">
                    <div class="eb-ready-stock">
                        ${total}
                        <small>stock</small>
                    </div>

                    <div class="eb-ready-store-count">
                        ${item.stores.length} TOKO
                    </div>
                </div>

                <div class="eb-ready-store-list"></div>
            `;

            const storeList =
                card.querySelector(
                    '.eb-ready-store-list'
                );

            [...item.stores]
                .sort(
                    (a, b) =>
                        b.stock - a.stock
                )
                .forEach(store => {
                    const storeRow =
                        document.createElement('div');

                    storeRow.className =
                        'eb-ready-store-row';

                    storeRow.innerHTML = `
                        <span
                            class="eb-ready-store-name"
                            title="${escapeHTML(store.name)}"
                        >
                            ${escapeHTML(store.name)}
                        </span>

                        <span
                            class="eb-ready-store-qty"
                        >
                            ${store.stock}
                        </span>
                    `;

                    /*
                     * =================================================
                     * PENTING:
                     * NAMA TOKO SEKARANG JUGA KLIK QTY ASLI CRM.
                     * Tidak lagi hanya scroll ke row.
                     * =================================================
                     */
                    storeRow.addEventListener(
                        'click',
                        function(event) {
                            event.preventDefault();
                            event.stopPropagation();

                            clickOriginalQty(
                                store,
                                item.row
                            );
                        }
                    );

                    storeList.appendChild(
                        storeRow
                    );
                });

            /*
             * Klik card/product/SKU juga menuju
             * row asli CRM.
             */
            card.addEventListener(
                'click',
                function(event) {
                    if (
                        event.target.closest(
                            '.eb-ready-store-row'
                        )
                    ) {
                        return;
                    }

                    jumpToRow(item.row);
                }
            );

            list.appendChild(card);
        });
    }

    // =========================================================
    // TOKO VIEW
    // =========================================================

    function renderStore(list, items) {
        list.innerHTML = '';

        const stores = {};

        items.forEach(item => {
            item.stores.forEach(store => {
                const key =
                    String(store.code) ||
                    store.name;

                if (!stores[key]) {
                    stores[key] = {
                        code: store.code,
                        name: store.name,
                        products: []
                    };
                }

                stores[key].products.push({
                    item,
                    store
                });
            });
        });

        Object.values(stores)
            .forEach(store => {
                const group =
                    document.createElement('div');

                group.className =
                    'eb-store-group';

                group.innerHTML = `
                    <div class="eb-store-header">
                        <div class="eb-store-title">
                            <span
                                class="eb-store-name"
                                title="${escapeHTML(store.name)}"
                            >
                                ${escapeHTML(store.name)}
                            </span>
                        </div>
                    </div>

                    <div class="eb-store-products"></div>
                `;

                const productsContainer =
                    group.querySelector(
                        '.eb-store-products'
                    );

                store.products
                    .sort(
                        (a, b) =>
                            a.item.name.localeCompare(
                                b.item.name
                            )
                    )
                    .forEach(product => {
                        const productRow =
                            document.createElement('div');

                        productRow.className =
                            'eb-store-product';

                        productRow.innerHTML = `
                            <div
                                class="eb-store-product-info"
                                title="${escapeHTML(product.item.name)}"
                            >
                                <div
                                    class="eb-store-product-name"
                                >
                                    ${escapeHTML(
                                        product.item.name
                                    )}
                                </div>

                                <div
                                    class="eb-store-product-sku"
                                >
                                    ${escapeHTML(
                                        product.item.sku
                                    )}
                                </div>
                            </div>

                            <div
                                class="eb-store-product-qty"
                            >
                                ${product.store.stock}
                            </div>
                        `;

                        /*
                         * =================================================
                         * PENTING:
                         * Di TOKO VIEW, klik nama SKU/produk sekarang
                         * langsung klik QTY asli CRM.
                         * =================================================
                         */
                        productRow
                            .querySelector(
                                '.eb-store-product-info'
                            )
                            .addEventListener(
                                'click',
                                function(event) {
                                    event.preventDefault();
                                    event.stopPropagation();

                                    clickOriginalQty(
                                        product.store,
                                        product.item.row
                                    );
                                }
                            );

                        /*
                         * Angka stock tetap bisa diklik.
                         */
                        productRow
                            .querySelector(
                                '.eb-store-product-qty'
                            )
                            .addEventListener(
                                'click',
                                function(event) {
                                    event.preventDefault();
                                    event.stopPropagation();

                                    clickOriginalQty(
                                        product.store,
                                        product.item.row
                                    );
                                }
                            );

                        productsContainer.appendChild(
                            productRow
                        );
                    });

                list.appendChild(group);
            });

        if (!Object.keys(stores).length) {
            list.innerHTML = `
                <div class="eb-ready-empty">
                    Tidak ada toko ready
                    yang cocok.
                </div>
            `;
        }
    }

    // =========================================================
    // RENDER
    // =========================================================

    function render() {
        const panel =
            document.getElementById(
                CONFIG.panelId
            );

        if (!panel) return;

        const list =
            document.getElementById(
                'ebReadyList'
            );

        const count =
            document.getElementById(
                'ebReadyCount'
            );

        if (!list || !count) return;

        const items =
            getFilteredItems();

        count.textContent = items.length;

        panel.classList.remove(
            'eb-view-sku',
            'eb-view-store'
        );

        panel.classList.add(
            currentView === 'sku'
                ? 'eb-view-sku'
                : 'eb-view-store'
        );

        if (!items.length) {
            list.innerHTML = `
                <div class="eb-ready-empty">
                    ${
                        currentSearch
                            ? 'Tidak ada data yang cocok dengan filter.'
                            : 'Tidak ada barang ready di halaman CRM.'
                    }
                </div>
            `;
            return;
        }

        if (currentView === 'sku') {
            renderSKU(list, items);
        } else {
            renderStore(list, items);
        }
    }

