// ==UserScript==
// @name         EraBlue CRM - Inventory Workspace (Ready Stock + QR/Barcode)
// @namespace    https://crm.erablue.id/
// @version      1.0.5
// @description  Tampilan Check Inventory penuh dengan Ready Stock SKU/Toko dan QR + Barcode pada modal Inventory Lock.
// @match        https://crm.erablue.id/kiem-tra-ton-kho*
// @run-at       document-idle
// @grant        none
// ==/UserScript==

(function () {
    'use strict';

    const CONFIG = {
        tableSelector: '#tbInventory',
        panelId: 'ebReadyStockPanel',
        minStock: 1,
        excludeStockAtOrAbove: 9999,
        skuMaxHeight: 320,
        storeMaxHeight: 320,
        scanDelay: 150
    };

    let inventoryData = [];
    let currentView = 'sku';
    let currentSearch = '';
    let currentTheme = 'dark';
    let excludeHighStock = true;

    let tableObserver = null;
    let bodyObserver = null;
    let scanTimer = null;
    let tableWatchTimer = null;
    let currentTable = null;
    let lastSignature = '';
    let selectedProductIDRef = '0';
    let selectedSiteID = '';
    let productSuggestTimer = null;
    let productSuggestRequest = 0;

    // =========================================================
    // CSS
    // =========================================================

    const css = `
        #tbInventory tr.eb-ready-row {
            background: rgba(34,197,94,.08) !important;
            box-shadow: inset 4px 0 0 #16a34a !important;
        }

        #tbInventory tr.eb-ready-row:hover {
            background: rgba(34,197,94,.15) !important;
        }

        #${CONFIG.panelId} {
            position: fixed !important;
            left: 18px !important;
            right: 18px !important;
            bottom: 16px !important;

            z-index: 2147483647 !important;
            isolation: isolate !important;

            background: rgba(15,23,42,.97) !important;
            color: #fff !important;

            border: 1px solid rgba(255,255,255,.12) !important;
            border-radius: 16px !important;

            box-shadow:
                0 12px 40px rgba(0,0,0,.35),
                0 2px 8px rgba(0,0,0,.2) !important;

            backdrop-filter: blur(12px) !important;
            -webkit-backdrop-filter: blur(12px) !important;

            font-family:
                -apple-system,
                BlinkMacSystemFont,
                "Segoe UI",
                Arial,
                sans-serif !important;

            overflow: visible !important;
        }

        #${CONFIG.panelId} * {
            box-sizing: border-box !important;
        }

        .eb-ready-header {
            display: grid;
            grid-template-columns: max-content max-content minmax(120px, 1fr) 36px 36px 36px 36px;
            align-items: center;
            gap: 10px;
            padding: 10px 15px;
            min-height: 58px;
            border-bottom: 1px solid rgba(255,255,255,.08);
        }

        .eb-ready-title {
            display: flex;
            align-items: center;
            gap: 9px;
            font-size: 14px;
            font-weight: 800;
            white-space: nowrap;
        }

        .eb-ready-dot {
            width: 9px;
            height: 9px;
            flex-shrink: 0;
            border-radius: 50%;
            background: #22c55e;
            box-shadow: 0 0 10px rgba(34,197,94,.8);
        }

        .eb-ready-count {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-width: 25px;
            height: 22px;
            padding: 0 7px;
            border-radius: 999px;
            background: #16a34a;
            color: #fff;
            font-size: 11px;
            font-weight: 800;
        }

        .eb-ready-search {
            display: block;
            width: 100%;
            min-width: 0;
            height: 36px;
            margin: 0;
            padding: 0 11px;
            border: 1px solid rgba(255,255,255,.12);
            border-radius: 8px;
            outline: none;
            background: rgba(255,255,255,.07);
            color: #fff;
            font-size: 12px;
        }

        .eb-ready-search::placeholder {
            color: rgba(255,255,255,.45);
        }

        .eb-ready-search:focus {
            border-color: rgba(34,197,94,.6);
            background: rgba(255,255,255,.10);
        }

        .eb-ready-btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border: 0;
            outline: none;
            cursor: pointer;
            width: 36px;
            min-width: 36px;
            height: 36px;
            margin: 0;
            padding: 0 10px;
            border-radius: 8px;
            background: rgba(255,255,255,.08);
            color: #fff;
            font-size: 11px;
            font-weight: 800;
        }

        .eb-ready-btn:hover {
            background: rgba(255,255,255,.16);
        }

        .eb-ready-btn.eb-exclude-toggle {
            width: 36px;
            min-width: 36px;
            padding: 0;
            flex: 0 0 36px;
            border: 1px solid rgba(255,255,255,.14);
