            option.addEventListener('click', event => {
                event.preventDefault();
                event.stopPropagation();
                chooseStatus();
            });
            option.addEventListener('keydown', event => {
                if (event.key === 'Enter' || event.key === ' ') {
                    event.preventDefault();
                    chooseStatus();
                } else if (event.key === 'Escape') {
                    statusField.classList.remove('open');
                    statusTrigger.setAttribute('aria-expanded', 'false');
                    statusTrigger.focus();
                }
            });
        });
        syncStatusDropdown();

        statusSelect.addEventListener('change', function () {
            syncStatusDropdown();
            setApiStatus('Status diubah ke ' + this.options[this.selectedIndex].text + '. Tekan SEARCH untuk request.', false);
        });

        document.addEventListener('click', function (event) {
            if (!event.target.closest('#' + CONFIG.panelId + ' .eb-api-field')) {
                panel.querySelectorAll('.eb-api-field.open').forEach(field => {
                    field.classList.remove('open');
                    const trigger = field.querySelector('.eb-api-trigger');
                    if (trigger) trigger.setAttribute('aria-expanded', 'false');
                });
            }
        }, true);

        render();
    }

    // =========================================================
    // TABLE SIGNATURE
    // =========================================================

    function getTableSignature(table) {
        if (!table) return '';

        const rows =
            table.querySelectorAll(
                'tbody tr'
            );

        let result = '';

        /*
         * Signature dibuat ringan tetapi cukup untuk mendeteksi:
         * - pagination
         * - search
         * - perubahan stock
         * - perubahan SKU
         * - perubahan toko
         */
        rows.forEach(row => {
            result += '|';

            const header =
                row.querySelector(
                    'th.row-header'
                );

            if (header) {
                result +=
                    header.textContent
                        .replace(/\s+/g, ' ')
                        .trim();
            }

            row.querySelectorAll('td')
                .forEach(cell => {
                    result += '§';
                    result +=
                        cell.className || '';
                    result += ':';
                    result +=
                        cell.textContent
                            .replace(/\s+/g, ' ')
                            .trim();
                });
        });

        return result;
    }

    // =========================================================
    // SCHEDULE SCAN
    // =========================================================

    function scheduleScan(delay = CONFIG.scanDelay) {
        clearTimeout(scanTimer);

        scanTimer = setTimeout(
            function() {
                const table =
                    document.querySelector(
                        CONFIG.tableSelector
                    );

                if (table !== currentTable) {
                    bindTableObserver(table);
                }

                scanTable();
            },
            delay
        );
    }

    // =========================================================
    // TABLE OBSERVER
    // =========================================================

    function bindTableObserver(table) {
        if (tableObserver) {
            tableObserver.disconnect();
            tableObserver = null;
        }

        currentTable = table || null;
        lastSignature = '';

        if (!table) {
            inventoryData = [];
            render();
            return;
        }

        tableObserver =
            new MutationObserver(
                function(mutations) {
                    let relevant = false;

                    for (const mutation of mutations) {
                        if (
                            mutation.type ===
                                'childList' ||
                            mutation.type ===
                                'characterData'
                        ) {
                            relevant = true;
                            break;
                        }
                    }

                    if (relevant) {
                        scheduleScan(120);
                    }
                }
            );

        tableObserver.observe(
            table,
            {
                childList: true,
                subtree: true,
                characterData: true
            }
        );
    }

    // =========================================================
    // GLOBAL WATCHER
    // =========================================================

    function installGlobalWatcher() {
        if (bodyObserver) {
            bodyObserver.disconnect();
        }

        /*
         * BODY observer:
         * menangkap table yang diganti/re-render.
         */
        bodyObserver =
            new MutationObserver(
                function(mutations) {
                    let relevant = false;

                    for (const mutation of mutations) {
                        const target =
                            mutation.target instanceof Element
                                ? mutation.target
                                : mutation.target.parentElement;

                        /*
                         * Abaikan perubahan dari panel sendiri.
                         */
                        if (
                            target &&
                            target.closest &&
                            target.closest(
                                `#${CONFIG.panelId}`
                            )
                        ) {
                            continue;
                        }

                        if (
                            mutation.type ===
                                'childList' ||
                            mutation.type ===
                                'characterData'
                        ) {
                            relevant = true;
                            break;
                        }
                    }

                    if (!relevant) return;

                    const table =
                        document.querySelector(
                            CONFIG.tableSelector
                        );

                    if (table !== currentTable) {
                        bindTableObserver(table);
                        scheduleScan(50);
                        return;
                    }

                    scheduleScan(120);
                }
            );

        bodyObserver.observe(
            document.body,
            {
                childList: true,
                subtree: true,
                characterData: true
            }
        );

        /*
         * Search/filter CRM.
         */
        document.addEventListener(
            'input',
            function(event) {
                if (
                    event.target &&
                    event.target.closest &&
                    event.target.closest(
                        `#${CONFIG.panelId}`
                    )
                ) {
                    return;
                }

                scheduleScan(100);
            },
            true
        );

        document.addEventListener(
            'change',
            function(event) {
                if (
                    event.target &&
                    event.target.closest &&
                    event.target.closest(
                        `#${CONFIG.panelId}`
                    )
                ) {
                    return;
                }

                scheduleScan(100);
            },
            true
        );

        /*
         * Pagination / tab / filter CRM yang hanya berubah
         * setelah klik.
         */
        document.addEventListener(
            'click',
            function(event) {
                if (
                    event.target &&
                    event.target.closest &&
                    event.target.closest(
                        `#${CONFIG.panelId}`
                    )
                ) {
                    return;
                }

                scheduleScan(250);
            },
            true
        );

        /*
         * Keyboard search / pagination.
         */
        document.addEventListener(
            'keyup',
            function(event) {
                if (
                    event.target &&
                    event.target.closest &&
                    event.target.closest(
                        `#${CONFIG.panelId}`
                    )
                ) {
                    return;
                }

                scheduleScan(250);
            },
            true
        );

        /*
         * History API untuk CRM SPA.
         */
        if (!history.__ebReadyStockPatched) {
            const originalPushState =
                history.pushState;

            const originalReplaceState =
                history.replaceState;

            history.pushState =
                function() {
                    const result =
                        originalPushState.apply(
                            this,
                            arguments
                        );

                    setTimeout(
                        () => scheduleScan(50),
                        0
                    );

                    return result;
                };

            history.replaceState =
                function() {
                    const result =
                        originalReplaceState.apply(
                            this,
                            arguments
                        );

                    setTimeout(
                        () => scheduleScan(50),
                        0
                    );

                    return result;
                };

            history.__ebReadyStockPatched =
                true;

            window.addEventListener(
                'popstate',
                () => scheduleScan(50)
            );
        }

        /*
         * Safety watcher:
         * tetap mengecek setiap 1 detik untuk kasus CRM
         * mengubah data tanpa mutation event yang terlihat.
         */
        clearInterval(tableWatchTimer);

        tableWatchTimer =
            setInterval(
                function() {
                    const table =
                        document.querySelector(
                            CONFIG.tableSelector
                        );

                    if (table !== currentTable) {
                        bindTableObserver(table);
                        scheduleScan(0);
                        return;
                    }

                    if (!table) {
                        if (
                            inventoryData.length
                        ) {
                            inventoryData = [];
                            render();
                        }

                        return;
                    }

                    const signature =
                        getTableSignature(
                            table
                        );

                    if (
                        signature !==
                        lastSignature
                    ) {
                        lastSignature =
                            signature;

                        scheduleScan(80);
                    }
                },
                1000
            );
    }

    // =========================================================
    // WAIT CRM
    // =========================================================

    function waitForCRM() {
        /*
         * Jangan tunggu #tbInventory.
         * Panel + API controls harus hidup walaupun CRM table belum render.
         */
        start();
    }

    // =========================================================
    // START
    // =========================================================

    function start() {
        injectCSS();
        createPanel();

        const table =
            document.querySelector(
                CONFIG.tableSelector
            );

        currentTable = table || null;

        bindTableObserver(table);

        scanTable();

        installGlobalWatcher();

        /*
         * AJAX/DataTables initial rendering.
         */
        setTimeout(
            () => scanTable(),
            300
        );

        setTimeout(
            () => scanTable(),
            1000
        );

        setTimeout(
            () => scanTable(),
            2500
        );

        setTimeout(
            () => scanTable(),
            5000
        );
    }

    // =========================================================
    // INIT
    // =========================================================

    if (
        document.readyState ===
        'loading'
    ) {
        document.addEventListener(
            'DOMContentLoaded',
            waitForCRM,
            { once: true }
        );
    } else {
        waitForCRM();
    }

})();

(function () {
    'use strict';

    const CONFIG = {
        MODAL_SELECTOR: '#mdLockDetail',
        MODAL_INFO_SELECTOR: '#divStoreInfo',
        MODAL_TABLE_SELECTOR: '.tables-lockDetail',
        PANEL_ID: 'ebStandaloneQrBarcode'
    };

    let pendingModalContext = {
        sku: '',
        storeName: ''
    };


    /* =========================================================
       ESCAPE HTML
    ========================================================= */

    function escapeHTML(value) {
        return String(value || '')
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;')
            .replace(/'/g, '&#039;');
    }


    /* =========================================================
       LOAD QR CODE
    ========================================================= */

    function loadQRCode() {
        return new Promise((resolve, reject) => {

            if (typeof window.QRCode !== 'undefined') {
                resolve();
                return;
            }

            const existing = document.querySelector(
                'script[data-eb-standalone-qrcode]'
            );

            if (existing) {

                existing.addEventListener(
                    'load',
                    () => resolve(),
                    { once: true }
                );

                existing.addEventListener(
                    'error',
                    () => reject(
                        new Error('QRCode library failed')
                    ),
                    { once: true }
                );

                return;
            }

            const script = document.createElement('script');

            script.src =
                'https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js';

            script.dataset.ebStandaloneQrcode = '1';

            script.onload = () => resolve();

            script.onerror = () => reject(
                new Error('QRCode library failed')
            );

            document.head.appendChild(script);
        });
    }


    /* =========================================================
       LOAD BARCODE
    ========================================================= */

    function loadBarcode() {
        return new Promise((resolve, reject) => {

            if (typeof window.JsBarcode === 'function') {
                resolve();
                return;
            }

            const existing = document.querySelector(
                'script[data-eb-standalone-barcode]'
            );

            if (existing) {

                existing.addEventListener(
                    'load',
                    () => resolve(),
                    { once: true }
                );

                existing.addEventListener(
                    'error',
                    () => reject(
                        new Error('JsBarcode library failed')
                    ),
                    { once: true }
                );

                return;
            }

            const script = document.createElement('script');

            script.src =
                'https://cdn.jsdelivr.net/npm/jsbarcode@3.11.6/dist/JsBarcode.all.min.js';

            script.dataset.ebStandaloneBarcode = '1';

            script.onload = () => resolve();

            script.onerror = () => reject(
                new Error('JsBarcode library failed')
            );

            document.head.appendChild(script);
        });
    }


    /* =========================================================
       GET SKU
    ========================================================= */

    function getModalSKU(modal) {

        if (!modal) {
            return '';
        }

        /* -----------------------------------------------------
           1. Dari tabel modal
        ----------------------------------------------------- */

        const skuElements = modal.querySelectorAll(
            `${CONFIG.MODAL_TABLE_SELECTOR} i`
        );

        for (const element of skuElements) {

            const value = element.textContent
                .replace(/\s+/g, '')
                .trim();

            if (/^\d{8,20}$/.test(value)) {
                return value;
            }
        }


        /* -----------------------------------------------------
           2. Dari TD pertama
        ----------------------------------------------------- */

        const firstCells = modal.querySelectorAll(
            `${CONFIG.MODAL_TABLE_SELECTOR} td:first-child`
        );

        for (const cell of firstCells) {

            const matches = cell.textContent.match(
                /\b\d{8,20}\b/g
            );

            if (matches && matches.length) {
                return matches[0];
            }
        }


        /* -----------------------------------------------------
           3. Dari onclick
        ----------------------------------------------------- */

        const onclickElements =
            modal.querySelectorAll('[onclick]');

        for (const element of onclickElements) {

            const onclick =
                element.getAttribute('onclick') || '';

            const match = onclick.match(
                /['"](\d{8,20})['"]/
            );

            if (match) {
                return match[1];
            }
        }


        /* -----------------------------------------------------
           4. Global CRM
        ----------------------------------------------------- */

        try {

            if (window._ProducCodeID) {

                const value = String(
                    window._ProducCodeID
                )
                    .replace(/\s+/g, '');

                if (/^\d{8,20}$/.test(value)) {
                    return value;
                }
            }

        } catch (error) {}


        /* -----------------------------------------------------
           5. Context
        ----------------------------------------------------- */

        if (
            pendingModalContext &&
            pendingModalContext.sku
        ) {

            const value = String(
                pendingModalContext.sku
            )
                .replace(/\s+/g, '');

            if (/^\d{8,20}$/.test(value)) {
                return value;
            }
        }

        return '';
    }


    /* =========================================================
       GET PRODUCT NAME
    ========================================================= */

    function getModalProductName(modal) {

        if (!modal) {
            return '';
        }

        const cell = modal.querySelector(
            `${CONFIG.MODAL_TABLE_SELECTOR} tbody tr td:first-child`
        );

        if (!cell) {
            return '';
        }

        const clone = cell.cloneNode(true);

        const codeElement = clone.querySelector('i');

        if (codeElement) {
            codeElement.remove();
        }

        return clone.textContent
            .replace(/\s+/g, ' ')
            .trim();
    }


    /* =========================================================
       GET STORE NAME
    ========================================================= */

    function getModalStoreName(modal) {

        if (!modal) {
            return '';
        }

        const info = modal.querySelector(
            CONFIG.MODAL_INFO_SELECTOR
        );

        if (info) {

            const text = info.textContent
                .replace(/\s+/g, ' ')
                .trim();

            const match = text.match(
                /Store name:\s*([^]+?)(?=\s+Store type:|$)/i
            );

            if (match) {
                return match[1].trim();
            }
        }


        if (
            pendingModalContext &&
            pendingModalContext.storeName
        ) {
            return pendingModalContext.storeName;
        }

        return '';
    }


    /* =========================================================
       REMOVE PANEL
    ========================================================= */

    function removeModalCode() {

        const old = document.getElementById(
            CONFIG.PANEL_ID
        );

        if (old) {
            old.remove();
        }
    }


    /* =========================================================
       CREATE PANEL
    ========================================================= */

    async function createModalCode(modal) {

        if (!modal) {
            return;
        }

        const info = modal.querySelector(
            CONFIG.MODAL_INFO_SELECTOR
        );

        if (!info) {
            return;
        }

        const sku = getModalSKU(modal);

        if (!sku) {
            return;
        }


        /* Jangan duplicate */

        const old = document.getElementById(
            CONFIG.PANEL_ID
        );

        if (
            old &&
            old.dataset.sku === sku
        ) {
            return;
        }

        removeModalCode();


        const productName =
            getModalProductName(modal);

        const storeName =
            getModalStoreName(modal);


        /* =====================================================
           PANEL
        ===================================================== */

        const panel = document.createElement('div');

        panel.id = CONFIG.PANEL_ID;

        panel.dataset.sku = sku;

        panel.innerHTML = `
            <div class="eb-code-title">
                QR + BARCODE
            </div>

            <div
                class="eb-qr"
                id="ebStandaloneModalQR"
            ></div>

            <svg
                class="eb-barcode"
                id="ebStandaloneModalBarcode"
                xmlns="http://www.w3.org/2000/svg"
            ></svg>

            <div class="eb-code-value">
                ${escapeHTML(sku)}
            </div>

            ${
                productName
                    ? `
                        <div class="eb-code-sub">
                            ${escapeHTML(productName)}
                        </div>
                    `
                    : ''
            }

            ${
                storeName
                    ? `
                        <div class="eb-code-sub">
                            ${escapeHTML(storeName)}
                        </div>
                    `
                    : ''
            }

            <button
                type="button"
                class="eb-copy"
                id="ebStandaloneCopy"
            >
                Copy SKU
            </button>
        `;


        /*
         * Masukkan ke awal divStoreInfo.
         * CSS float:right akan membuat panel
         * berada di sebelah kanan.
         */

        info.insertBefore(
            panel,
            info.firstChild
        );


        /* =====================================================
           LOAD LIBRARY
        ===================================================== */

        try {

            await Promise.all([
                loadQRCode(),
                loadBarcode()
            ]);

        } catch (error) {

            console.error(
                '[EraBlue QR]',
                error
            );

            return;
        }


        /* =====================================================
           QR
        ===================================================== */

        const qr =
            document.getElementById(
                'ebStandaloneModalQR'
            );

        if (qr) {

            qr.innerHTML = '';

            new window.QRCode(qr, {
                text: sku,
                width: 150,
                height: 150,
                colorDark: '#000000',
                colorLight: '#ffffff',
                correctLevel:
                    window.QRCode.CorrectLevel.M
            });
        }


        /* =====================================================
           BARCODE
        ===================================================== */

        const barcode =
            document.getElementById(
                'ebStandaloneModalBarcode'
            );

        if (barcode) {

            window.JsBarcode(
                barcode,
                sku,
                {
                    format: 'CODE128',
                    width: 1.5,
                    height: 45,
                    displayValue: false,
                    margin: 0
                }
            );
        }


        /* =====================================================
           COPY SKU
        ===================================================== */

        const copyButton =
            document.getElementById(
                'ebStandaloneCopy'
            );

        if (copyButton) {

            copyButton.addEventListener(
                'click',
                async function () {

                    try {

                        await navigator.clipboard.writeText(
                            sku
                        );

                        const oldText =
                            this.textContent;

                        this.textContent =
                            'Copied';

                        setTimeout(() => {
                            this.textContent =
                                oldText;
                        }, 1000);

                    } catch (error) {

                        const textarea =
                            document.createElement(
                                'textarea'
                            );

                        textarea.value = sku;

                        document.body.appendChild(
                            textarea
                        );

                        textarea.select();

                        document.execCommand(
                            'copy'
                        );

                        textarea.remove();

                        this.textContent =
                            'Copied';

                        setTimeout(() => {
                            this.textContent =
                                'Copy SKU';
                        }, 1000);
                    }
                }
            );
        }
    }


    /* =========================================================
