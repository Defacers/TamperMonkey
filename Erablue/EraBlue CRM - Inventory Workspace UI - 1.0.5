        .eb-ready-btn.eb-exclude-toggle.active {
            background: rgba(245, 158, 11, .20);
            color: #fbbf24;
            border-color: rgba(245, 158, 11, .45);
        }

        .eb-ready-view-switch {
            display: flex;
            align-items: center;
            justify-self: start;
            height: 36px;
            gap: 3px;
            padding: 3px;
            flex-shrink: 0;
            background: rgba(255,255,255,.06);
            border: 1px solid rgba(255,255,255,.08);
            border-radius: 9px;
        }

        .eb-ready-view-btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            height: 28px;
            margin: 0;
            line-height: 1;
            padding: 0 9px;
            border: 0;
            border-radius: 6px;
            background: transparent;
            color: rgba(255,255,255,.45);
            cursor: pointer;
            font-size: 9px;
            font-weight: 800;
        }

        .eb-ready-view-btn.active {
            background: rgba(255,255,255,.14);
            color: #fff;
        }

        .eb-ready-list {
            padding: 10px;
            scroll-behavior: smooth;
        }

        .eb-ready-list::-webkit-scrollbar {
            width: 7px;
            height: 7px;
        }

        .eb-ready-list::-webkit-scrollbar-thumb {
            background: rgba(255,255,255,.20);
            border-radius: 999px;
        }

        #${CONFIG.panelId}.eb-view-sku .eb-ready-list {
            display: grid;
            grid-template-columns: repeat(auto-fill,minmax(250px,1fr));
            gap: 8px;
            max-height: ${CONFIG.skuMaxHeight}px;
            overflow-x: hidden;
            overflow-y: auto;
            align-content: start;
        }

        .eb-ready-card {
            min-width: 0;
            padding: 11px;
            border-radius: 11px;
            background: rgba(255,255,255,.065);
            border: 1px solid rgba(255,255,255,.08);
            cursor: pointer;
        }

        .eb-ready-card:hover {
            background: rgba(255,255,255,.10);
        }

        .eb-ready-product {
            min-width: 0;
            font-size: 12px;
            font-weight: 750;
            line-height: 1.35;
            color: #fff;
            white-space: normal;
            overflow-wrap: anywhere;
            word-break: normal;
        }

        .eb-ready-sku {
            margin-top: 4px;
            font-size: 10px;
            color: rgba(255,255,255,.45);
            font-family: monospace;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .eb-ready-info {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 8px;
            margin-top: 8px;
        }

        .eb-ready-stock {
            color: #4ade80;
            font-size: 15px;
            font-weight: 900;
        }

        .eb-ready-stock small {
            font-size: 10px;
            font-weight: 600;
            color: rgba(255,255,255,.55);
        }

        .eb-ready-store-count {
            padding: 4px 7px;
            border-radius: 6px;
            background: rgba(34,197,94,.12);
            color: #4ade80;
            font-size: 9px;
            font-weight: 800;
        }

        .eb-ready-store-list {
            margin-top: 9px;
            padding-top: 8px;
            border-top: 1px solid rgba(255,255,255,.07);
        }

        .eb-ready-store-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 8px;
            padding: 5px 6px;
            border-radius: 6px;
            color: rgba(255,255,255,.68);
            font-size: 9px;
            cursor: pointer;
        }

        .eb-ready-store-row:hover {
            background: rgba(255,255,255,.07);
        }

        .eb-ready-store-name {
            min-width: 0;
            overflow: hidden;
            white-space: nowrap;
            text-overflow: ellipsis;
            cursor: pointer;
        }

        .eb-ready-store-qty {
            flex-shrink: 0;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-width: 25px;
            padding: 3px 7px;
            border-radius: 5px;
            background: rgba(34,197,94,.10);
            color: #4ade80;
            font-weight: 900;
            cursor: pointer;
        }

        .eb-ready-store-qty:hover {
            background: rgba(34,197,94,.25);
        }

        #${CONFIG.panelId}.eb-view-store .eb-ready-list {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
            gap: 8px;
            max-height: ${CONFIG.skuMaxHeight}px;
            overflow-x: hidden;
            overflow-y: auto;
            align-items: stretch;
            align-content: start;
        }

        .eb-store-group {
            min-width: 0;
            width: 100%;
            height: 100%;
            box-sizing: border-box;
            padding: 11px;
            border-radius: 11px;
            background: rgba(255,255,255,.065);
            border: 1px solid rgba(255,255,255,.08);
            display: flex;
            flex-direction: column;
            cursor: pointer;
            transition: background .15s ease;
        }

        /* Samakan highlight seluruh card StoreView dengan card SKUView. */
        .eb-store-group:hover {
            background: rgba(255,255,255,.10);
        }

        .eb-store-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 8px;
            padding-bottom: 8px;
            border-bottom: 1px solid rgba(255,255,255,.07);
        }

        .eb-store-name {
            min-width: 0;
            max-width: 100%;
            overflow-wrap: anywhere;
            word-break: normal;
            white-space: normal;
            color: #fff;
            font-size: 11px;
            line-height: 1.35;
            font-weight: 800;
            cursor: inherit;
        }

        .eb-store-products {
            margin-top: 7px;
            flex: 1 1 auto;
            min-height: 0;
            overflow: visible;
        }

        .eb-store-product {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 8px;
            padding: 6px 8px;
            margin-bottom: 4px;
            border-radius: 6px;
            cursor: pointer;
            transition: background .15s ease;
        }

        .eb-store-product:hover {
            background: rgba(255,255,255,.07);
        }

        .eb-store-product-info {
            min-width: 0;
            flex: 1;
            cursor: pointer;
        }

        .eb-store-product-name {
            min-width: 0;
            color: rgba(255,255,255,.75);
            font-size: 9px;
            line-height: 1.35;
            white-space: normal;
            overflow-wrap: anywhere;
            word-break: normal;
        }

        .eb-store-product-sku {
            margin-top: 2px;
            color: rgba(255,255,255,.35);
            font-family: monospace;
            font-size: 8px;
        }

        .eb-store-product-qty {
            flex-shrink: 0;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-width: 28px;
            padding: 4px 7px;
            border-radius: 5px;
            background: rgba(34,197,94,.10);
            color: #4ade80;
            font-size: 10px;
            font-weight: 900;
            cursor: pointer;
        }

        .eb-ready-empty {
            width: 100%;
            padding: 25px 10px;
            text-align: center;
            color: rgba(255,255,255,.45);
            font-size: 12px;
        }

        #${CONFIG.panelId}.eb-collapsed .eb-ready-list {
            display: none !important;
        }

        @media(max-width:900px) {
            .eb-ready-header {
                grid-template-columns: max-content max-content minmax(120px, 1fr) 36px 36px 36px 36px;
                gap: 8px;
            }

            .eb-ready-search {
                width: 100%;
            }

            #${CONFIG.panelId}.eb-view-sku .eb-ready-list {
                grid-template-columns: 1fr;
                max-height: 260px;
            }

            #${CONFIG.panelId}.eb-view-store .eb-ready-list {
                max-height: 220px;
            }
        }

        @media(max-width:700px) {
            #${CONFIG.panelId} {
                left: 8px !important;
                right: 8px !important;
                bottom: 8px !important;
            }

            .eb-ready-header {
                grid-template-columns: minmax(0, 1fr) max-content max-content max-content;
                gap: 8px;
            }

            .eb-ready-title { grid-column: 1; }
            .eb-ready-view-switch { grid-column: 2 / 4; grid-row: 1; justify-self: end; }
            .eb-ready-search { grid-column: 1 / 3; grid-row: 2; }
            #ebReadyRefresh { grid-column: 3; grid-row: 2; }
            #ebReadyCollapse { grid-column: 3; grid-row: 1; justify-self: end; }

            .eb-store-group {
                flex-basis: 245px;
            }
        }
        /* =====================================================
           DIRECT CRM REQUEST UI
           ===================================================== */
        #ebReadyStockPanel .eb-api-bar {
            padding: 10px 12px;
            display: grid;
            grid-template-columns: minmax(100px, .55fr) minmax(170px, 1fr) minmax(200px, 1.25fr) minmax(200px, 1.25fr) minmax(180px, 1fr) 76px;
            gap: 8px;
            align-items: center;
            border-bottom: 1px solid rgba(255,255,255,.08);
            background: rgba(0,0,0,.10);
        }

        /* Samakan tinggi setiap kolom agar tidak terpengaruh CSS bawaan CRM. */
        #ebReadyStockPanel .eb-api-field {
            position: relative;
            min-width: 0;
            width: 100%;
            height: 36px;
            min-height: 36px;
            margin: 0 !important;
            padding: 0 !important;
            align-self: center;
            display: flex;
            align-items: stretch;
        }

        #ebReadyStockPanel .eb-api-btn,
        #ebReadyStockPanel .eb-api-trigger,
        #ebReadyStockPanel .eb-api-input {
            display: block !important;
            box-sizing: border-box !important;
            position: relative !important;
            top: 0 !important;
            margin: 0 !important;
            align-self: stretch;
            flex: 1 1 auto;
            width: 100%;
            min-width: 0;
            height: 36px !important;
            min-height: 36px !important;
            max-height: 36px !important;
            padding-top: 0;
            padding-bottom: 0;
            border: 1px solid rgba(255,255,255,.13);
            border-radius: 8px;
            background: rgba(255,255,255,.07);
            color: #fff;
            outline: none;
            font-size: 11px;
            font-weight: 700;
            line-height: normal;
            vertical-align: middle;
        }

        /* Status select remains the source of truth for existing request logic; its visual
           control is a custom dropdown so options match Province / Store / Category exactly. */
        #ebReadyStockPanel #ebApiStatus.eb-api-input {
            display: none !important;
        }
        #ebReadyStockPanel #ebApiStatusField .eb-api-trigger {
            font-family: inherit !important;
            font-size: 11px !important;
            font-weight: 600 !important;
            color: #f8fafc !important;
            background-color: #202936 !important;
            border-color: rgba(255,255,255,.13) !important;
        }
        #ebReadyStockPanel #ebApiStatusField .eb-api-menu {
            min-width: 100% !important;
            width: max(100%, 190px) !important;
            max-height: none !important;
            padding: 5px !important;
        }
        #ebReadyStockPanel #ebApiStatusField .eb-api-options {
            max-height: none !important;
            padding: 0 !important;
        }
        #ebReadyStockPanel #ebApiStatusField .eb-api-option {
            display: block !important;
            width: 100% !important;
            min-height: 30px !important;
            padding: 8px 10px !important;
            box-sizing: border-box !important;
            color: rgba(255,255,255,.86) !important;
            background: transparent !important;
            font-family: inherit !important;
            font-size: 11px !important;
            font-weight: 500 !important;
            line-height: 14px !important;
            white-space: nowrap !important;
            cursor: pointer !important;
            border-radius: 6px !important;
        }
        #ebReadyStockPanel #ebApiStatusField .eb-api-option:hover,
        #ebReadyStockPanel #ebApiStatusField .eb-api-option.selected {
            color: #ffffff !important;
            background: rgba(255,255,255,.10) !important;
        }
        #ebReadyStockPanel.eb-theme-light #ebApiStatusField .eb-api-trigger {
            color: #172033 !important;
            background-color: #ffffff !important;
            border-color: #cbd5e1 !important;
        }
        #ebReadyStockPanel.eb-theme-light #ebApiStatusField .eb-api-menu {
            background: #ffffff !important;
            border-color: #cbd5e1 !important;
            box-shadow: 0 15px 40px rgba(15,23,42,.16) !important;
        }
        #ebReadyStockPanel.eb-theme-light #ebApiStatusField .eb-api-option {
            color: #334155 !important;
            background: transparent !important;
        }
        #ebReadyStockPanel.eb-theme-light #ebApiStatusField .eb-api-option:hover,
        #ebReadyStockPanel.eb-theme-light #ebApiStatusField .eb-api-option.selected {
            color: #0f172a !important;
            background: #e8eef6 !important;
        }

        #ebReadyStockPanel .eb-api-trigger {
            cursor: pointer;
            text-align: left;
            padding: 0 28px 0 10px;
            position: relative;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        #ebReadyStockPanel .eb-api-trigger::after {
            content: "▾";
            position: absolute;
            right: 9px;
            top: 10px;
            color: rgba(255,255,255,.55);
        }

        #ebReadyStockPanel .eb-api-input {
            padding: 0 10px;
        }

        #ebReadyStockPanel .eb-api-input::placeholder {
            color: rgba(255,255,255,.42);
        }

        #ebReadyStockPanel .eb-api-input:focus,
        #ebReadyStockPanel .eb-api-trigger:focus {
            border-color: rgba(34,197,94,.65);
            background: rgba(255,255,255,.10);
        }

        #ebReadyStockPanel .eb-api-btn {
            cursor: pointer;
            background: #16a34a;
            border-color: #16a34a;
            color: #fff;
        }

        #ebReadyStockPanel .eb-api-btn:hover {
            background: #15803d;
        }

        #ebReadyStockPanel .eb-api-btn.eb-loading {
            opacity: .65;
            pointer-events: none;
        }

        #ebReadyStockPanel .eb-api-menu {
            display: none;
            position: absolute;
            left: 0;
            top: calc(100% + 6px);
            bottom: auto;
            width: 100%;
            min-width: 220px;
            max-height: 310px;
            overflow: hidden;
            z-index: 2147483647;
            background: #111827;
            border: 1px solid rgba(255,255,255,.16);
            border-radius: 10px;
            box-shadow: 0 15px 40px rgba(0,0,0,.55);
        }

        #ebReadyStockPanel .eb-api-field.open {
            z-index: 2147483646;
        }

        #ebReadyStockPanel .eb-api-field.open .eb-api-menu {
            display: block;
        }

        /* Autocomplete produk: khusus Search SKU / Nama Barang, filter lain tidak disentuh. */
        #ebReadyStockPanel .eb-api-search-field { position: relative; }
        #ebReadyStockPanel .eb-product-suggestions {
            display: none; position: absolute; top: calc(100% + 2px); left: 0; right: 0;
            max-height: 320px; overflow-y: auto; z-index: 2147483647;
            background: #f5f5f5; color: #222; border: 1px solid #ccc;
            border-radius: 0 0 5px 5px; box-shadow: 0 4px 10px rgba(0,0,0,.22);
        }
        #ebReadyStockPanel .eb-product-suggestions.visible { display: block; }
        #ebReadyStockPanel .eb-product-suggestion {
            display: block; width: 100%; padding: 7px 9px; border: 0; border-bottom: 1px solid #ddd;
            background: transparent; color: inherit; text-align: left; font: inherit; cursor: pointer;
            white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
        }
        #ebReadyStockPanel .eb-product-suggestion:hover,
        #ebReadyStockPanel .eb-product-suggestion.active { background: #dcecff; }

        #ebReadyStockPanel .eb-api-menu-tools {
            display: flex;
            gap: 6px;
            padding: 7px;
            border-bottom: 1px solid rgba(255,255,255,.08);
        }

        #ebReadyStockPanel .eb-api-menu-search {
            flex: 1;
            min-width: 0;
            height: 29px;
            padding: 0 8px;
            border: 1px solid rgba(255,255,255,.12);
            border-radius: 7px;
            background: rgba(255,255,255,.06);
            color: #fff;
            outline: none;
            font-size: 10px;
        }

        #ebReadyStockPanel .eb-api-menu-action {
            height: 29px;
            padding: 0 8px;
            border: 0;
            border-radius: 7px;
            background: rgba(255,255,255,.08);
            color: #fff;
            cursor: pointer;
            font-size: 9px;
            font-weight: 800;
        }

        #ebReadyStockPanel .eb-api-options {
            max-height: 255px;
            overflow-y: auto;
            padding: 5px;
        }

        #ebReadyStockPanel .eb-api-option {
            display: flex;
            align-items: center;
            gap: 7px;
            min-height: 29px;
            padding: 4px 6px;
            border-radius: 6px;
            color: rgba(255,255,255,.78);
            font-size: 10px;
            cursor: pointer;
        }

        #ebReadyStockPanel .eb-api-option:hover {
            background: rgba(255,255,255,.07);
        }

        #ebReadyStockPanel .eb-api-option input {
            margin: 0;
            accent-color: #22c55e;
        }

        #ebReadyStockPanel .eb-api-status {
            padding: 5px 12px;
            min-height: 24px;
            color: rgba(255,255,255,.45);
            font-size: 9px;
            border-bottom: 1px solid rgba(255,255,255,.06);
        }

        #ebReadyStockPanel .eb-api-status.error {
            color: #fca5a5;
        }

        #ebReadyStockPanel .eb-api-status.ok {
            color: #86efac;
        }

        @media(max-width:1250px) {
            #ebReadyStockPanel .eb-api-bar {
                grid-template-columns: repeat(3, minmax(0, 1fr));
            }
        }

        @media(max-width:900px) {
            #ebReadyStockPanel .eb-api-bar {
                grid-template-columns: repeat(2, minmax(0, 1fr));
                gap: 8px;
            }
            #ebReadyStockPanel .eb-api-field.eb-api-search-field,
            #ebReadyStockPanel .eb-api-field.eb-api-button-field {
                grid-column: span 2;
            }
        }

        @media(max-width:700px) {
            #ebReadyStockPanel .eb-api-bar {
                grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
                gap: 8px;
                padding: 9px;
            }
