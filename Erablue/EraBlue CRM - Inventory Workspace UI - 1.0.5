                background: #e9e9e9 !important;
            }

        `;

        document.head.appendChild(style);
    }


    /* =========================================================
       CHECK MODAL
    ========================================================= */

    function checkModal() {

        const modal =
            document.querySelector(
                CONFIG.MODAL_SELECTOR
            );

        if (!modal) {
            return;
        }


        const style =
            window.getComputedStyle(modal);

        const visible =
            style.display !== 'none' &&
            style.visibility !== 'hidden' &&
            modal.offsetWidth > 0 &&
            modal.offsetHeight > 0;

        if (!visible) {
            return;
        }


        createModalCode(modal);
    }


    /* =========================================================
       OBSERVER
    ========================================================= */

    function startObserver() {

        const observer =
            new MutationObserver(() => {

                clearTimeout(
                    window.__ebQrTimer
                );

                window.__ebQrTimer =
                    setTimeout(
                        checkModal,
                        100
                    );
            });


        observer.observe(
            document.body,
            {
                childList: true,
                subtree: true,
                attributes: true,
                attributeFilter: [
                    'style',
                    'class'
                ]
            }
        );
    }


    /* =========================================================
       INIT
    ========================================================= */

    function init() {

        injectCSS();

        startObserver();

        setTimeout(
            checkModal,
            500
        );
    }


    if (
        document.readyState ===
        'loading'
    ) {

        document.addEventListener(
            'DOMContentLoaded',
            init
        );

    } else {

        init();
    }

})();

