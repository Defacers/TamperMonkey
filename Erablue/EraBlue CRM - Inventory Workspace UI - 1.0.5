    function setApiStatus(message, isError) {
        const el = document.getElementById('ebApiStatusText');
        if (!el) return;

        el.textContent = message;
        el.classList.toggle('error', !!isError);
        el.classList.toggle('ok', !isError);
    }

    function closeApiMenus() {
        document.querySelectorAll(
            '#' + CONFIG.panelId + ' .eb-api-field.open'
        ).forEach(field => field.classList.remove('open'));
    }

    function setupApiDropdown(type) {
        const field = document.getElementById('ebApi' + capitalize(type) + 'Field');
        if (!field) return;

        const trigger = field.querySelector('.eb-api-trigger');
        const menu = field.querySelector('.eb-api-menu');
        const search = field.querySelector('.eb-api-menu-search');
        const options = field.querySelector('.eb-api-options');

        trigger.addEventListener('click', function (event) {
            event.preventDefault();
            event.stopPropagation();

            document.querySelectorAll(
                '#' + CONFIG.panelId + ' .eb-api-field.open'
            ).forEach(other => {
                if (other !== field) other.classList.remove('open');
            });

            const willOpen = !field.classList.contains('open');
            field.classList.toggle('open', willOpen);

            if (willOpen) {
                // Fokuskan kolom pencarian ketika dropdown dibuka,
                // tanpa menghapus teks pencarian sebelumnya.
                window.requestAnimationFrame(() => {
                    if (field.classList.contains('open')) {
                        search.focus({ preventScroll: true });
                        try {
                            const end = search.value.length;
                            search.setSelectionRange(end, end);
                        } catch (e) {}
                    }
                });
            }
        });

        // Enter/Escape hanya melepas fokus input; jangan mengosongkan teks.
        // Escape tidak menutup dropdown dan tidak mengubah filter yang sedang aktif.
        search.addEventListener('keydown', function (event) {
            if (event.key === 'Enter' || event.key === 'Escape' || event.key === 'Esc') {
                event.preventDefault();
                event.stopPropagation();
                this.blur();
            }
        });

        menu.addEventListener('click', function (event) {
            event.stopPropagation();
        });

        search.addEventListener('input', function () {
            const needle = normalizeText(this.value);

            options.querySelectorAll('.eb-api-option').forEach(option => {
                const text = normalizeText(option.textContent);
                option.style.display =
                    !needle || text.includes(needle) ? 'flex' : 'none';
            });
        });

        field.querySelector('[data-action="all"]').addEventListener('click', function () {
            const map = apiState[type];

            if (type === 'province') {
                map.clear();
                API_PROVINCES.forEach(item => map.set(String(item.id), item));
                renderApiOptions(type);
                loadStoresForSelectedProvinces(true);
                return;
            }

            if (type === 'store') {
                apiState.storeAll.forEach(item => map.set(String(item.id), item));
            } else if (type === 'category') {
                apiState.categoryAll.forEach(item => map.set(String(item.id), item));
            }

            renderApiOptions(type);
        });

        field.querySelector('[data-action="clear"]').addEventListener('click', function () {
            apiState[type].clear();
            renderApiOptions(type);

            if (type === 'province') {
                loadStoresForSelectedProvinces(false);
            }
        });
    }

    function capitalize(value) {
        return value.charAt(0).toUpperCase() + value.slice(1);
    }

    function normalizeText(value) {
        return String(value || '')
            .toLowerCase()
            .normalize('NFD')
            .replace(/[\u0300-\u036f]/g, '')
            .replace(/\s+/g, ' ')
            .trim();
    }

    function escapeHTML(value) {
        return String(value || '')
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;')
            .replace(/'/g, '&#039;');
    }

    function populateProvinceOptions() {
        apiState.province.clear();
        renderApiOptions('province');
    }

    function renderApiOptions(type) {
        const options = document.getElementById(
            'ebApi' + capitalize(type) + 'Options'
        );

        if (!options) return;

        let data = [];

        if (type === 'province') data = API_PROVINCES;
        if (type === 'store') data = apiState.storeAll;
        if (type === 'category') data = apiState.categoryAll;

        options.innerHTML = '';

        if (!data.length) {
            options.innerHTML = '<div style="padding:12px;color:rgba(255,255,255,.45);font-size:10px;">Tidak ada data.</div>';
            updateApiTrigger(type);
            return;
        }

        const selected = apiState[type];

        data.forEach(item => {
            const id = String(item.id);

            const label = document.createElement('label');
            label.className = 'eb-api-option';

            label.innerHTML = `
                <input type="checkbox" value="${escapeHTML(id)}" ${selected.has(id) ? 'checked' : ''}>
                <span>${escapeHTML(item.name)}</span>
            `;

            const checkbox = label.querySelector('input');

            checkbox.addEventListener('change', function () {
                if (this.checked) {
                    selected.set(id, item);
                } else {
                    selected.delete(id);
                }

                updateApiTrigger(type);

                if (type === 'province') {
                    loadStoresForSelectedProvinces(true);
                }
            });

            options.appendChild(label);
        });

        updateApiTrigger(type);
    }

    function updateApiTrigger(type) {
        const trigger = document.getElementById(
            'ebApi' + capitalize(type) + 'Trigger'
        );

        if (!trigger) return;

        const selected = apiState[type];
        const all =
            type === 'province'
                ? API_PROVINCES
                : type === 'store'
                    ? apiState.storeAll
                    : apiState.categoryAll;

        if (!selected.size) {
            trigger.textContent =
                type === 'province'
                    ? 'Semua Provinsi'
                    : type === 'store'
                        ? 'Semua Toko'
                        : 'Semua Kategori';
            return;
        }

        if (selected.size === all.length) {
            trigger.textContent =
                type === 'province'
                    ? 'Semua Provinsi (' + all.length + ')'
                    : type === 'store'
                        ? 'Semua Toko (' + all.length + ')'
                        : 'Semua Kategori (' + all.length + ')';
            return;
        }

        const first = Array.from(selected.values())[0];
        trigger.textContent =
            selected.size === 1
                ? first.name
                : selected.size + ' dipilih';
    }

    async function loadAllCategories() {
        setApiStatus('Memuat semua kategori dari CRM...', false);

        try {
            const response = await fetch(
                '/AjaxApi/GetAllMaingroup',
                {
                    method: 'POST',
                    credentials: 'same-origin',
                    headers: {
                        'Content-Type': 'application/json; charset=utf-8',
                        'X-Requested-With': 'XMLHttpRequest'
                    },
                    body: '{}'
                }
            );

            if (!response.ok) {
                throw new Error('HTTP ' + response.status);
            }

            const data = await response.json();

            apiState.categoryAll = Array.isArray(data)
                ? data
                    .map(item => ({
                        id: item.MAINGROUPID,
                        name: item.MAINGROUPNAME
                    }))
                    .filter(item => item.id !== undefined && item.name)
                : [];

            apiState.category.clear();
            renderApiOptions('category');

            setApiStatus(
                'Kategori CRM siap: ' + apiState.categoryAll.length + ' data.',
                false
            );
        } catch (error) {
            console.error('[EraBlue Ready Stock] category API error:', error);
            setApiStatus('Gagal memuat kategori CRM: ' + error.message, true);
        }
    }

    async function loadStoresForSelectedProvinces(selectAll) {
        const provinceIds = Array.from(apiState.province.keys());
        const lstProvince = provinceIds.length
            ? provinceIds.join(',') + ','
            : '';

        setApiStatus(
            provinceIds.length
                ? 'Memuat toko sesuai ' + provinceIds.length + ' provinsi...'
                : 'Memuat semua toko dari CRM...',
            false
        );

        try {
            const response = await fetch(
                '/AjaxApi/GetAllERPPMStores_string',
                {
                    method: 'POST',
                    credentials: 'same-origin',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8',
                        'X-Requested-With': 'XMLHttpRequest'
                    },
                    body: new URLSearchParams({
                        lstProvince: lstProvince,
                        type: selectAll ? 'true' : 'false'
                    }).toString()
                }
            );

            if (!response.ok) {
                throw new Error('HTTP ' + response.status);
            }

            const data = await response.json();
            const temp = document.createElement('select');

            temp.innerHTML = data && data.html ? data.html : '';

            apiState.storeAll = Array.from(temp.options)
                .map(option => ({
                    id: option.value,
                    name: option.textContent.replace(/\s+/g, ' ').trim()
                }))
                .filter(item => item.id !== '' && item.name);

            /*
             * Bila provinsi dipilih, semua toko hasil provinsi otomatis
             * dipilih supaya filter provinsi benar-benar diterapkan
             * pada endpoint CheckInventory_View.
             *
             * Bila tidak ada provinsi, kosong = semua toko CRM.
             */
            apiState.store.clear();

            if (provinceIds.length || selectAll) {
                apiState.storeAll.forEach(item => {
                    apiState.store.set(String(item.id), item);
                });
            }

            renderApiOptions('store');

            setApiStatus(
                'Toko CRM siap: ' + apiState.storeAll.length + ' data.',
                false
            );
        } catch (error) {
            console.error('[EraBlue Ready Stock] store API error:', error);
            apiState.storeAll = [];
            apiState.store.clear();
            renderApiOptions('store');
            setApiStatus('Gagal memuat daftar toko CRM: ' + error.message, true);
        }
    }

    function getApiCsv(type) {
        return Array.from(apiState[type].keys()).join(',') +
            (apiState[type].size ? ',' : '');
    }

    async function requestInventoryFromCRM() {
        if (apiState.loading) return;

        const input = document.getElementById('ebApiSearch');
        const status = document.getElementById('ebApiStatus');
        const button = document.getElementById('ebApiSearchBtn');

        if (!input || !status || !button) return;

        const key = input.value.trim();

        if (key.length < 4) {
            setApiStatus(
                'Search CRM membutuhkan minimal 4 karakter.',
                true
            );
            input.focus();
            return;
        }

        if (key.length > 100) {
            setApiStatus(
                'Search CRM maksimal 100 karakter.',
                true
            );
            input.focus();
            return;
        }

        closeApiMenus();

        apiState.loading = true;
        button.classList.add('eb-loading');
        button.textContent = '...';

        const lstStore = getApiCsv('store');
        const lstMainGroup = getApiCsv('category');
        const inventoryStatusID = status.value || '1';

        /*
         * Sama dengan parameter CheckInventory_View pada source CRM.
         * ProductIDRef/SiteID sengaja 0/kosong karena search UI ini
         * memakai keyword langsung.
         */
        const payload = new URLSearchParams({
            lstStore: lstStore,
            lstMainGroup: lstMainGroup,
            key: key,
            typeSort: '1',
            inventoryStatusID: inventoryStatusID,
            ProductIDRef: String(selectedProductIDRef || '0'),
            rangeType: '-1',
            SiteID: String(selectedSiteID || ''),
            IsCheckInventory: '0'
        });

        setApiStatus(
            'Request CRM: ' +
            key +
            ' | toko=' +
            (apiState.store.size || 'ALL') +
            ' | kategori=' +
            (apiState.category.size || 'ALL'),
            false
        );

        try {
            const response = await fetch(
                '/SaleOrder/CheckInventory_View',
                {
                    method: 'POST',
                    credentials: 'same-origin',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8',
                        'X-Requested-With': 'XMLHttpRequest'
                    },
                    body: payload.toString()
                }
            );

            if (!response.ok) {
                throw new Error('HTTP ' + response.status);
            }

            const html = await response.text();

            let inventory = document.getElementById('divInventory');

            /*
             * Jika user menekan SEARCH sebelum CRM selesai membuat
             * container hasil, buat host sementara di panel.
             * Saat CRM #divInventory muncul, hasil berikutnya otomatis
             * akan kembali masuk ke container CRM asli.
             */
            if (!inventory) {
                inventory = document.createElement('div');
                inventory.id = 'ebApiResultHost';
                inventory.className = 'scrollable-table';
                inventory.style.cssText =
                    'position:fixed;left:18px;right:18px;top:20px;bottom:470px;' +
                    'z-index:2147483000;overflow:auto;background:#fff;color:#111;' +
                    'border:1px solid #ddd;border-radius:10px;padding:8px;';

                document.body.appendChild(inventory);
            }

            inventory.innerHTML = html;

            /*
             * CRM menaruh hidden product list di hasil HTML.
             * Gunakan fungsi original CRM bila tersedia.
             */
            try {
                const productList = document.getElementById('hdLstProduct');

                if (
                    productList &&
                    typeof window.GetURLForProduct === 'function'
                ) {
                    window.GetURLForProduct(productList.value || '');
                }
            } catch (e) {
                console.warn(
                    '[EraBlue Ready Stock] GetURLForProduct:',
                    e
                );
            }

            currentTable = null;
            lastSignature = '';
            scheduleScan(80);

            setTimeout(() => scanTable(), 250);
            setTimeout(() => scanTable(), 800);
            setTimeout(() => scanTable(), 1500);

            setApiStatus(
                'Search selesai. Hasil CRM sudah dimuat ke table.',
                false
            );
        } catch (error) {
            console.error(
                '[EraBlue Ready Stock] inventory API error:',
                error
            );

            setApiStatus(
                'Request inventory gagal: ' + error.message,
                true
            );
        } finally {
            apiState.loading = false;
            button.classList.remove('eb-loading');
            button.textContent = 'SEARCH';
        }
    }

    function setupProductAutocomplete(panel) {
        const input = panel.querySelector('#ebApiSearch');
        const menu = panel.querySelector('#ebApiProductSuggestions');
        if (!input || !menu) return;
        let activeIndex = -1;
        let suggestions = [];

        const close = () => {
            menu.classList.remove('visible');
            input.setAttribute('aria-expanded', 'false');
            activeIndex = -1;
        };
        const selectItem = item => {
            if (!item) return;
            input.value = item.value || item.label || '';
            selectedProductIDRef = item.key == null ? '0' : String(item.key);
            selectedSiteID = item.SiteID == null ? '' : String(item.SiteID);
            close();
            input.focus({ preventScroll: true });
            // Enter/SEARCH sesudah memilih produk akan mengirim ProductIDRef dan SiteID CRM.
        };
        const render = items => {
            suggestions = items;
            activeIndex = -1;
            menu.replaceChildren();
            items.forEach((item, index) => {
                const option = document.createElement('button');
                option.type = 'button';
                option.className = 'eb-product-suggestion';
                option.setAttribute('role', 'option');
                option.textContent = item.label || item.value || '';
                option.addEventListener('mousedown', event => event.preventDefault());
                option.addEventListener('click', () => selectItem(item));
                menu.appendChild(option);
            });
            menu.classList.toggle('visible', items.length > 0);
            input.setAttribute('aria-expanded', items.length ? 'true' : 'false');
        };
        const fetchSuggestions = async term => {
            const requestId = ++productSuggestRequest;
            try {
                const response = await fetch('/SaleOrder/ProductSeachSuggest', {
                    method: 'POST', credentials: 'same-origin',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8',
                        'X-Requested-With': 'XMLHttpRequest'
                    },
                    body: new URLSearchParams({ keyWord: term.replace(/-/g, ' '), ManuId: '-1' }).toString()
                });
                if (!response.ok) throw new Error('HTTP ' + response.status);
                const data = await response.json();
                if (requestId !== productSuggestRequest || input.value.trim() !== term) return;
                const items = (Array.isArray(data) ? data : []).map(item => {
                    const name = item.productNameField || item.ProductName || item.productName || '';
                    const price = Number(item.priceField ?? item.Price ?? item.productErpPriceBOField?.priceField ?? 0);
                    const key = item.productIDField ?? item.ProductId ?? item.productId ?? '0';
                    const site = item.listSiteIDField ?? (window.gencompany == 7 ? 7 : '0');
                    const priceText = price > 0 ? ', Price: ' + price.toLocaleString('en-US') : '';
                    return { label: name + priceText, value: name, key, SiteID: site };
                }).filter(item => item.value);
                render(items);
            } catch (error) {
                if (requestId === productSuggestRequest) close();
                console.warn('[EraBlue Inventory] product autocomplete:', error);
            }
        };

        input.addEventListener('input', function () {
            selectedProductIDRef = '0';
            selectedSiteID = '';
            clearTimeout(productSuggestTimer);
            const term = this.value.trim();
            if (term.length < 2) { ++productSuggestRequest; close(); return; }
            productSuggestTimer = setTimeout(() => fetchSuggestions(term), 350);
        });
        input.addEventListener('keydown', function (event) {
            if (!menu.classList.contains('visible')) return;
            if (event.key === 'ArrowDown' && suggestions.length) {
                event.preventDefault(); activeIndex = (activeIndex + 1) % suggestions.length;
            } else if (event.key === 'ArrowUp' && suggestions.length) {
                event.preventDefault(); activeIndex = (activeIndex - 1 + suggestions.length) % suggestions.length;
            } else if (event.key === 'Enter' && activeIndex >= 0) {
                event.preventDefault(); event.stopPropagation(); selectItem(suggestions[activeIndex]); return;
            } else if (event.key === 'Escape' || event.key === 'Esc') {
                // Esc hanya menutup suggestion dan melepas fokus; nilai input tetap ada.
                event.preventDefault(); event.stopPropagation(); close(); this.blur(); return;
            }
            [...menu.children].forEach((node, i) => node.classList.toggle('active', i === activeIndex));
            if (activeIndex >= 0) menu.children[activeIndex]?.scrollIntoView({ block: 'nearest' });
        });
        input.addEventListener('blur', () => setTimeout(() => {
            if (!menu.contains(document.activeElement)) close();
        }, 120));
        document.addEventListener('click', event => {
            if (!event.target.closest('#ebApiSearch') && !event.target.closest('#ebApiProductSuggestions')) close();
        });
    }

