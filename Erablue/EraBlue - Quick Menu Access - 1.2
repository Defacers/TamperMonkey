// ==UserScript==
// @name         EraBlue Quick Menu Access (All Clickable)
// @namespace    http://tampermonkey.net/
// @version      1.2
// @description  Panel akses cepat menu EraBlue — webview & screen (deep-link)
// @author       You
// @match        https://*.erablue.id/*
// @grant        none
// ==/UserScript==

(function () {
    'use strict';

    // =====================================================================
    // MODE:
    //   'direct'   -> hanya buka URL yang valid dari log (webview)
    //   'deeplink' -> screen juga dicoba via pola URL webapp.erablue.id
    // =====================================================================

    // Base app shell untuk native screen (pola sama dengan 'office')
    const WEBAPP_BASE = 'https://webapp.erablue.id';

    // Fungsi pembentuk URL deep-link untuk menu 'screen'
    // Coba beberapa pola — urutan = prioritas
    function buildScreenUrls(menu) {
        return [
            `${WEBAPP_BASE}/erawork/${menu.menu}`,
            `${WEBAPP_BASE}/${menu.menu}`,
            `${WEBAPP_BASE}/erawork/${menu.id}`,
            `${WEBAPP_BASE}`, // fallback: buka app shell
        ];
    }

    // ================== DATA MENU ==================
    const MENUS = [
        // ---------- CATEGORY 8 : WAREHOUSE / LOGISTICS ----------
        { id: 8008, menu: 'kho',                 title: 'Kho',                       en: 'Warehouse',                indo: 'Gudang',                    cat: 8, type: 'webview', url: 'https://whssapp.erablue.id',                                                  urlValid: true },
        { id: 8010, menu: 'nhap_hang_pallet',    title: 'Nhập hàng pallet',          en: 'Pallet Receiving',         indo: 'Penerimaan Palet',          cat: 8, type: 'webview', url: 'https://whssapp.erablue.id/receiving/management',                              urlValid: true },
        { id: 8009, menu: 'xep_hang_pallet',     title: 'Xếp hàng pallet',           en: 'Merge Pallet',             indo: 'Gabung Palet',              cat: 8, type: 'webview', url: 'https://whssapp.erablue.id/mergepallet',                                       urlValid: true },
        { id: 8011, menu: 'cham_hang_alphabet',  title: 'Chấm hàng alphabet',        en: 'Alphabet Product Check',   indo: 'Pemeriksaan Produk Alfabet',cat: 8, type: 'webview', url: 'https://whssapp.erablue.id/addproductalphabet',                                urlValid: true },
        { id: 8061, menu: 'ma_danh_tinh',        title: 'Mã danh tính',              en: 'Identity Code',            indo: 'Kode Identitas',            cat: 8, type: 'webview', url: 'https://logisticsapp.erablue.id/Logistics/IdentityCode/IdentityCode',          urlValid: true },
        { id: 8062, menu: 'gui_hang_noi_bo',     title: 'Gửi nhận hàng nội bộ',      en: 'Internal Delivery',        indo: 'Pengiriman Barang Internal',cat: 8, type: 'webview', url: 'https://logisticsapp.erablue.id/Logistics/InternalDelivery/UpdateBillStatus',   urlValid: true },

        { id: 8000, menu: 'logistics',           title: 'Logistics',                 en: 'Logistics',                indo: 'Logistik',                  cat: 8, type: 'screen', navigator: 'LogisticsNavigator', urlValid: false },
        { id: 8012, menu: 'chung_tu_van_chuyen', title: 'Chứng từ vận chuyển',       en: 'Transport Voucher',        indo: 'Dokumen Pengangkutan',      cat: 8, type: 'screen', urlValid: false },
        { id: 8015, menu: 'xac_nhan_chung_tu',   title: 'Xác nhận chứng từ',         en: 'Confirm Bill',             indo: 'Konfirmasi Dokumen',        cat: 8, type: 'screen', urlValid: false },
        { id: 8019, menu: 'ds_chung_tu_nhan_phat',title:'Danh sách chứng từ nhận phát',en:'Receive Voucher List',     indo: 'Daftar Dokumen Terima/Kirim',cat: 8, type: 'screen', urlValid: false },
        { id: 8044, menu: 'nhan_hang_ban_giao',  title: 'Nhận hàng bàn giao',        en: 'Receive Handover',         indo: 'Penerimaan Serah Terima',   cat: 8, type: 'screen', urlValid: false },

        // ---------- CATEGORY 6 : ACCOUNTING ----------
        { id: 2126, menu: 'duyet_bien_ban_kiem_quy', title: 'Duyệt biên bản kiểm quỹ', en: 'Approve Cash Count Report', indo: 'Setujui Berita Acara Pemeriksaan Kas', cat: 6, type: 'webview', url: 'https://accounting.erablue.id/payment/reviewed-daily-fund', urlValid: true },
        { id: 2108, menu: 'yeu_cau_thanh_toan',  title: 'Yêu cầu thanh toán',        en: 'Payment Request',          indo: 'Permintaan Pembayaran',     cat: 6, type: 'screen', urlValid: false },
        { id: 2122, menu: 'phieu_thu_chi',       title: 'Phiếu thu chi',             en: 'Cash Receipt/Payment Voucher', indo: 'Bukti Terima/Bayar Kas', cat: 6, type: 'screen', urlValid: false },

        // ---------- CATEGORY 12 / 1 : MISC ----------
        { id: 2293, menu: 'camera_dmx',          title: 'Camera Era',                en: 'Camera Era',               indo: 'Kamera Era',                cat: 12, type: 'webview', url: 'https://camera.erablue.id',                                                    urlValid: true },
        { id: 2285, menu: 'reportdmx',           title: 'BI Reports',                en: 'BI Reports',               indo: 'Laporan BI',                cat: 1,  type: 'webview', url: 'https://businessintelligence.erablue.id/dashboard/',                            urlValid: true },
        { id: 2295, menu: 'office',              title: 'Office',                    en: 'Office',                   indo: 'Kantor',                    cat: 1,  type: 'webview', url: 'https://webapp.erablue.id/erawork/office',                                      urlValid: true },
        { id: 3018, menu: 'chuyen_sieu_thi_lam_viec', title: 'Chuyển siêu thị làm việc', en:'Transfer Store Tasks',   indo: 'Pindah Tugas Store',        cat: 1,  type: 'screen', urlValid: false },
        // menuID 3000 terpotong di log — lengkapi manual
    ];

    const CATEGORY_NAMES = {
        1:  '🏢 Umum / Kantor',
        6:  '💰 Akuntansi / Pembayaran',
        8:  '📦 Gudang / Logistik',
        12: '📷 Kamera & Lainnya',
    };

    // State: apakah mode deep-link aktif (screen ikut diklik)
    let deeplinkMode = localStorage.getItem('era_deeplink_mode') === '1';

    // ================== STYLE ==================
    const css = `
        #era-btn{position:fixed;bottom:20px;right:20px;width:56px;height:56px;border-radius:50%;
            background:linear-gradient(135deg,#007bff,#0056b3);color:#fff;font-size:24px;border:none;
            cursor:pointer;z-index:2147483646;box-shadow:0 4px 12px rgba(0,0,0,.35);
            display:flex;align-items:center;justify-content:center;transition:transform .2s}
        #era-btn:hover{transform:scale(1.1)}
        #era-panel{position:fixed;top:0;right:-420px;width:400px;max-width:92vw;height:100vh;
            background:#1e1e2f;color:#eee;z-index:2147483647;box-shadow:-4px 0 20px rgba(0,0,0,.5);
            transition:right .25s ease;display:flex;flex-direction:column;
            font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,sans-serif}
        #era-panel.open{right:0}
        #era-head{padding:16px;background:#151523;display:flex;justify-content:space-between;
            align-items:center;border-bottom:1px solid #333}
        #era-head h2{margin:0;font-size:16px;color:#fff}
        #era-close{background:#e74c3c;border:none;color:#fff;width:32px;height:32px;
            border-radius:50%;cursor:pointer;font-size:16px;line-height:1}
        #era-search{margin:12px 16px 6px;padding:10px 12px;border-radius:8px;border:1px solid #333;
            background:#2a2a3d;color:#eee;font-size:14px;outline:none}
        #era-search::placeholder{color:#888}
        #era-toggle-wrap{display:flex;align-items:center;gap:8px;margin:6px 16px 0;font-size:12px;color:#bbb}
        #era-toggle-wrap input{accent-color:#007bff;cursor:pointer}
        #era-list{flex:1;overflow-y:auto;padding:8px 16px 20px}
        .era-cat{font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.5px;
            color:#6c7cff;margin:18px 0 8px}
        .era-item{position:relative;padding:10px 12px 10px;margin-bottom:6px;border-radius:8px;
            background:#2a2a3d;color:#eee;text-decoration:none;font-size:14px;
            border-left:3px solid transparent;transition:background .15s,border-color .15s;
            display:block;cursor:pointer}
        .era-item:hover{background:#353552;border-left-color:#6c7cff}
        .era-item.screen{border-left-color:#75d1a0}
        .era-item.screen:hover{border-left-color:#75d1a0}
        .era-title{font-weight:600;display:block;padding-right:70px}
        .era-sub{font-size:11px;color:#999;display:block;margin-top:2px;padding-right:70px}
        .era-badge{position:absolute;top:10px;right:10px;font-size:10px;padding:2px 6px;
            border-radius:4px;background:#444;color:#ccc}
        .era-item.webview .era-badge{background:#0d6efd33;color:#6ea8fe}
        .era-item.screen  .era-badge{background:#19875433;color:#75d1a0}
        .era-copy{position:absolute;bottom:8px;right:10px;font-size:10px;padding:2px 6px;
            border-radius:4px;background:#3a3a55;color:#bbb;border:1px solid #555;cursor:pointer}
        .era-copy:hover{background:#4a4a70;color:#fff}
        #era-list::-webkit-scrollbar{width:8px}
        #era-list::-webkit-scrollbar-thumb{background:#444;border-radius:4px}
        .era-note{margin:8px 16px 0;padding:8px 10px;font-size:11px;color:#9fc5ff;
            background:#1a2740;border-radius:6px;border-left:3px solid #4a7bd0}
    `;
    const st = document.createElement('style'); st.textContent = css; document.head.appendChild(st);

    // ================== BUILD UI ==================
    const btn = document.createElement('button');
    btn.id = 'era-btn'; btn.innerHTML = '☰'; btn.title = 'EraBlue Quick Menu';
    document.body.appendChild(btn);

    const panel = document.createElement('div');
    panel.id = 'era-panel';
    panel.innerHTML = `
        <div id="era-head">
            <h2>⚡ EraBlue Quick Menu</h2>
            <button id="era-close">✕</button>
        </div>
        <input id="era-search" type="text" placeholder="🔍 Cari menu (title / en / indo / menu)..." />
        <label id="era-toggle-wrap">
            <input type="checkbox" id="era-deeplink" ${deeplinkMode ? 'checked' : ''}/>
            Deep-link mode — coba buka menu <b>screen</b> via webapp.erablue.id
        </label>
        <div class="era-note" id="era-note">
            ℹ️ <b>WEB</b> = URL pasti dari log. <b>APP</b> = native screen (deep-link, mungkin 404).
        </div>
        <div id="era-list"></div>
    `;
    document.body.appendChild(panel);

    const listEl   = panel.querySelector('#era-list');
    const searchEl = panel.querySelector('#era-search');
    const toggleEl = panel.querySelector('#era-deeplink');
    const noteEl   = panel.querySelector('#era-note');

    // ================== RENDER ==================
    function resolveScreenUrl(menu) {
        // Prioritas pertama: pola /erawork/{menu} (sama seperti 'office')
        return buildScreenUrls(menu)[0];
    }

    function itemHtml(m) {
        const sub = `${m.en || ''}${m.indo ? ' • ' + m.indo : ''}`;
        if (m.type === 'webview') {
            return `
                <a class="era-item webview" href="${m.url}" target="_blank" rel="noopener noreferrer" title="${m.url}">
                    <span class="era-badge">WEB</span>
                    <span class="era-title">${m.title}</span>
                    <span class="era-sub">${sub}</span>
                    <button class="era-copy" data-copy="${m.url}">Copy URL</button>
                </a>`;
        }
        // screen
        if (deeplinkMode) {
            const url = resolveScreenUrl(m);
            return `
                <a class="era-item screen" href="${url}" target="_blank" rel="noopener noreferrer"
                   title="Deep-link: ${url}">
                    <span class="era-badge">APP→WEB</span>
                    <span class="era-title">${m.title}</span>
                    <span class="era-sub">${sub} — coba: /erawork/${m.menu}</span>
                    <button class="era-copy" data-copy="${m.menu}">Copy key</button>
                </a>`;
        }
        // screen tanpa deeplink: tetap clickable (buka app shell)
        return `
            <a class="era-item screen" href="${WEBAPP_BASE}" target="_blank" rel="noopener noreferrer"
               title="Buka app shell webapp.erablue.id">
                <span class="era-badge">APP</span>
                <span class="era-title">${m.title}</span>
                <span class="era-sub">${sub} — menu: ${m.menu}</span>
                <button class="era-copy" data-copy="${m.menu}">Copy key</button>
            </a>`;
    }

    function renderList(filter = '') {
        const q = filter.trim().toLowerCase();
        const filtered = MENUS.filter(m => !q ||
            m.title.toLowerCase().includes(q) ||
            m.menu.toLowerCase().includes(q) ||
            (m.en   || '').toLowerCase().includes(q) ||
            (m.indo || '').toLowerCase().includes(q)
        );

        if (!filtered.length) {
            listEl.innerHTML = '<p style="color:#888;text-align:center;margin-top:40px;">Menu tidak ditemukan</p>';
            return;
        }

        const groups = {};
        filtered.forEach(m => (groups[m.cat] = groups[m.cat] || []).push(m));

        let html = '';
        Object.keys(groups).sort((a,b)=>a-b).forEach(cid => {
            html += `<div class="era-cat">${CATEGORY_NAMES[cid] || 'Kategori ' + cid}</div>`;
            groups[cid].forEach(m => { html += itemHtml(m); });
        });
        listEl.innerHTML = html;
    }

    // ================== EVENTS ==================
    btn.addEventListener('click', () => {
        panel.classList.toggle('open');
        if (panel.classList.contains('open')) {
            renderList(searchEl.value);
            setTimeout(() => searchEl.focus(), 100);
        }
    });
    panel.querySelector('#era-close').addEventListener('click', () => panel.classList.remove('open'));
    searchEl.addEventListener('input', e => renderList(e.target.value));

    toggleEl.addEventListener('change', e => {
        deeplinkMode = e.target.checked;
        localStorage.setItem('era_deeplink_mode', deeplinkMode ? '1' : '0');
        noteEl.innerHTML = deeplinkMode
            ? '🧪 <b>Deep-link mode ON</b> — menu APP akan dibuka via <code>/erawork/{menu}</code>. Jika 404, coba Copy key lalu buka manual di app.'
            : 'ℹ️ <b>WEB</b> = URL pasti dari log. <b>APP</b> = native screen (deep-link, mungkin 404).';
        renderList(searchEl.value);
    });

    // Copy-to-clipboard (delegation) — jangan sampai klik tombol memicu navigasi link
    listEl.addEventListener('click', (e) => {
        const copyBtn = e.target.closest('.era-copy');
        if (!copyBtn) return;
        e.preventDefault();
        e.stopPropagation();
        const val = copyBtn.dataset.copy;
        navigator.clipboard.writeText(val).then(() => {
            const old = copyBtn.textContent;
            copyBtn.textContent = '✓ Copied';
            setTimeout(() => { copyBtn.textContent = old; }, 1200);
        }).catch(() => {
            // fallback
            const ta = document.createElement('textarea');
            ta.value = val; document.body.appendChild(ta); ta.select();
            document.execCommand('copy'); ta.remove();
            copyBtn.textContent = '✓ Copied';
            setTimeout(() => { copyBtn.textContent = 'Copy'; }, 1200);
        });
    });

    document.addEventListener('keydown', e => { if (e.key === 'Escape') panel.classList.remove('open'); });

    renderList();
})();
