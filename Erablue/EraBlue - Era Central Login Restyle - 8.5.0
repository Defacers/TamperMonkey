// ==UserScript==
// @name         EraBlue - Keycloak Login Restyle (era-central) [v8.5 - ID+OTP + URL Guard]
// @namespace    https://erablue.id/
// @version      8.5.0
// @description  Form ID + OTP bersamaan, verifikasi sesi. Guard khusus URL authentication_expired di hrm.erablue.id/login.
// @author       You
// @match        https://authkey.erablue.id/realms/era-central/*
// @match        https://hrm.erablue.id/login*
// @grant        none
// @run-at       document-start
// ==/UserScript==

(function () {
  'use strict';

  const CFG = {
    bannerColor: '#0046B2',
    gradientA: '#1363DF',
    gradientB: '#32ACFF',
    logoUrl: 'https://authkey.erablue.id/resources/u35ih/login/tgddOTP/img/logo.webp',
    title: 'Login era-central',
    storageKey: 'era_sso_username',
    refreshGuardKey: 'era_sso_last_refresh',
    refreshCountKey: 'era_sso_refresh_count',
    refreshGuardMs: 10000,      // minimal 10 detik antar refresh
    maxRefreshCount: 3,         // maks 3x refresh beruntun
    refreshCountResetMs: 60000, // reset counter setelah 60 detik tanpa error
  };

  // ============================================================
  // GUARD SPESIFIK: hanya URL authentication_expired di /login
  // ============================================================
  if (/^hrm\.erablue\.id$/.test(location.hostname) && /^\/login(\/|$)/.test(location.pathname)) {
    handleExpiredUrlGuard();
    return;
  }

  function handleExpiredUrlGuard() {
    const params = new URLSearchParams(location.search);
    const err = params.get('error');
    const desc = params.get('error_description');

    // Cek KETAT: harus persis kombinasi ini
    const isExactExpired =
      err === 'temporarily_unavailable' &&
      desc === 'authentication_expired';

    if (!isExactExpired) {
      // Bukan URL error yang kita target → tidak lakukan apa pun
      console.log('[EraSSO] /login tanpa error target — skip guard.');
      return;
    }

    console.log('[EraSSO] URL authentication_expired terdeteksi — cek guard...');

    const now = Date.now();
    let last = 0, count = 0;
    try {
      last = parseInt(sessionStorage.getItem(CFG.refreshGuardKey) || '0', 10);
      count = parseInt(sessionStorage.getItem(CFG.refreshCountKey) || '0', 10);
    } catch (_) {}

    // Reset counter kalau sudah lama
    if (last && now - last > CFG.refreshCountResetMs) {
      count = 0;
      try { sessionStorage.setItem(CFG.refreshCountKey, '0'); } catch (_) {}
    }

    // Guard 1: jeda minimal antar refresh
    if (now - last < CFG.refreshGuardMs) {
      console.warn('[EraSSO] Guard: baru saja refresh (' + (now - last) + 'ms lalu), skip.');
      return;
    }

    // Guard 2: batas maksimal refresh beruntun
    if (count >= CFG.maxRefreshCount) {
      console.warn('[EraSSO] Guard: sudah ' + count + 'x refresh beruntun, stop untuk hindari loop.');
      return;
    }

    // Lolos guard → refresh ke /login bersih
    try {
      sessionStorage.setItem(CFG.refreshGuardKey, String(now));
      sessionStorage.setItem(CFG.refreshCountKey, String(count + 1));
      sessionStorage.removeItem(CFG.storageKey);
    } catch (_) {}

    console.log('[EraSSO] Refresh ke /login bersih (count=' + (count + 1) + ').');
    location.replace('https://hrm.erablue.id/login');
  }

  // ============================================================
  // CSS (authkey only)
  // ============================================================
  const css = `
    html, body { margin:0; padding:0;
      font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,"Helvetica Neue",Arial,sans-serif;
      font-size:14px; background:#fff; }
    body.era-sso-ready .pf-v5-c-login { display:none !important; }

    .era-sso-page { display:flex; width:100vw; min-height:100vh; overflow:hidden;
      animation:eraFadeIn .35s ease both; }
    @keyframes eraFadeIn { from{opacity:0} to{opacity:1} }

    .era-sso-banner { position:relative; width:50%; display:flex; align-items:center; justify-content:center;
      background-color:${CFG.bannerColor}; overflow:hidden; }
    .era-sso-banner__circle { position:absolute; top:50%; left:50%; transform:translate(-50%,-50%);
      width:80%; max-width:60rem; aspect-ratio:1/1; border-radius:50%;
      background:radial-gradient(circle at 30% 30%, rgba(255,255,255,.12), rgba(255,255,255,0) 70%);
      pointer-events:none; }
    .era-sso-banner__dots { position:absolute; width:22vw; height:12vw;
      background-image:radial-gradient(rgba(255,255,255,.35) 2px, transparent 2px);
      background-size:18px 18px; opacity:.5; pointer-events:none; }
    .era-sso-banner__dots.tl { top:0; left:0; }
    .era-sso-banner__dots.br { bottom:0; right:0; }
    .era-sso-banner__logo { position:relative; z-index:2; width:60%; max-width:22rem;
      background:#fff; border-radius:1rem; padding:.75rem; box-shadow:0 20px 60px rgba(0,0,0,.25);
      animation:eraPop .5s cubic-bezier(.2,.8,.2,1) both; }
    .era-sso-banner__logo img { width:100%; display:block; border-radius:.5rem; }
    @keyframes eraPop { from{opacity:0; transform:scale(.92)} to{opacity:1; transform:scale(1)} }

    .era-sso-main { width:50%; display:flex; align-items:center; justify-content:center;
      padding:2rem 1rem; background:#fff; }
    .era-sso-card { width:100%; max-width:32rem; padding:2rem 1.75rem;
      border:.15rem solid #E0E0E0; border-radius:1rem;
      animation:eraSlideUp .45s cubic-bezier(.2,.8,.2,1) both; animation-delay:.08s; }
    @keyframes eraSlideUp { from{opacity:0; transform:translateY(14px)} to{opacity:1; transform:translateY(0)} }

    .era-sso-card h1 { margin:0 0 1.5rem; text-align:center; font-size:1.75rem;
      font-weight:600; color:#21262f; letter-spacing:-.02em; }

    .era-form-group { margin-bottom:1rem; }
    .era-form-group label { display:block; padding-left:.2rem; margin-bottom:.4rem;
      font-weight:600; color:#343A40; font-size:.9rem; }
    .era-input { width:100%; box-sizing:border-box; min-height:3rem; padding:.6rem .85rem;
      font-size:1rem; color:#495057; background:#fff; border:1.5px solid #ced4da; border-radius:.6rem;
      transition:border-color .2s, box-shadow .2s, background .2s; outline:none; }
    .era-input:focus { border-color:${CFG.gradientB}; box-shadow:0 0 0 .2rem rgba(50,172,255,.25); }
    .era-input:disabled { background:#f1f3f5; color:#adb5bd; cursor:not-allowed; border-color:#e9ecef; }

    .era-input.era-otp {
      text-align:center; font-size:1.25rem; font-weight:600;
      letter-spacing:.35em; text-indent:.35em;
      padding:.6rem .85rem; min-height:3rem;
      font-variant-numeric: tabular-nums; caret-color:#1363DF;
    }
    .era-input.era-otp::placeholder { letter-spacing:.25em; text-indent:.25em;
      font-weight:400; color:#ced4da; }

    .era-hint { margin-top:.4rem; font-size:.78rem; color:#868e96; padding-left:.2rem;
      min-height:1rem; transition:color .2s; }

    .era-btn-submit { position:relative; width:100%; min-height:3rem; margin-top:.5rem;
      font-size:1.05rem; font-weight:600; color:#fff; cursor:pointer; border:none; border-radius:.6rem;
      background:linear-gradient(90deg, ${CFG.gradientA} 27.57%, ${CFG.gradientB} 100%);
      transition:transform .15s, box-shadow .2s, opacity .2s; overflow:hidden; z-index:1;
      display:flex; align-items:center; justify-content:center; gap:.5rem; }
    .era-btn-submit:hover:not(:disabled) { transform:translateY(-1px); box-shadow:0 8px 20px rgba(19,99,223,.35); }
    .era-btn-submit:active { transform:translateY(0); }
    .era-btn-submit:disabled { opacity:.55; cursor:not-allowed; transform:none; box-shadow:none; }

    .era-spinner { width:1rem; height:1rem; border:2px solid rgba(255,255,255,.5);
      border-top-color:#fff; border-radius:50%; animation:eraSpin .7s linear infinite; flex-shrink:0; }
    @keyframes eraSpin { to{transform:rotate(360deg)} }

    .era-alert { margin:.85rem 0 .25rem; padding:.65rem .85rem; font-size:.88rem; font-weight:500;
      color:#b02a37; background:#f8d7da; border:1px solid #f1aeb5; border-radius:.5rem;
      animation:eraFadeIn .25s ease both; line-height:1.4; }
    .era-alert--info { color:#084298; background:#cfe2ff; border-color:#b6d4fe; }
    .era-alert--success { color:#0f5132; background:#d1e7dd; border-color:#a3cfbb; }
    .era-hidden { display:none !important; }

    @media (max-width:52rem) {
      .era-sso-page { flex-direction:column-reverse; min-height:100vh; }
      .era-sso-banner { width:100%; min-height:12rem; padding:1.25rem 1rem; }
      .era-sso-banner__logo { width:60%; max-width:13rem; }
      .era-sso-main { width:100%; padding:1.5rem .75rem 2.5rem; }
      .era-sso-card { padding:1.5rem 1.25rem; }
      .era-sso-card h1 { font-size:1.5rem; }
      .era-input.era-otp { font-size:1.15rem; letter-spacing:.3em; text-indent:.3em;
        min-height:3rem; padding:.6rem .7rem; }
    }
  `;
  const styleEl = document.createElement('style');
  styleEl.id = 'era-sso-style';
  styleEl.textContent = css;
  document.head.appendChild(styleEl);

  // ============================================================
  // HELPER
  // ============================================================
  const $ = (sel, ctx = document) => ctx.querySelector(sel);
  function parseHTML(html) { return new DOMParser().parseFromString(html, 'text/html'); }
  function escapeHtml(s){return String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));}
  function saveUser(u){try{sessionStorage.setItem(CFG.storageKey,u);}catch(_){}}
  function loadUser(){try{return sessionStorage.getItem(CFG.storageKey)||'';}catch(_){return '';}}

  function getLoginAction() {
    const f = $('#kc-form-login');
    return f ? f.getAttribute('action') : null;
  }

  // ============================================================
  // VERIFIKASI SESI
  // ============================================================
  async function verifySession() {
    try {
      const res = await fetch(
        'https://authkey.erablue.id/realms/era-central/protocol/openid-connect/userinfo',
        { credentials: 'include', redirect: 'manual', cache: 'no-store' }
      );
      return res.status === 200;
    } catch (_) {
      return false;
    }
  }

  async function waitForSession(maxRetries = 3, delayMs = 300) {
    for (let i = 0; i < maxRetries; i++) {
      if (await verifySession()) return true;
      console.log('[EraSSO] Sesi belum siap, retry', i + 1);
      await new Promise(r => setTimeout(r, delayMs));
    }
    return false;
  }

  // ============================================================
  // SHELL
  // ============================================================
  function buildShell() {
    if ($('.era-sso-page')) return;
    const page = document.createElement('div');
    page.className = 'era-sso-page';
    page.innerHTML = `
      <div class="era-sso-banner">
        <div class="era-sso-banner__circle"></div>
        <div class="era-sso-banner__dots tl"></div>
        <div class="era-sso-banner__dots br"></div>
        <div class="era-sso-banner__logo">
          <img src="${CFG.logoUrl}" alt="EraBlue" onerror="this.style.display='none'">
        </div>
      </div>
      <div class="era-sso-main">
        <div class="era-sso-card">
          <h1>${CFG.title}</h1>
          <div id="era-slot"></div>
        </div>
      </div>`;
    document.body.appendChild(page);
    document.body.classList.add('era-sso-ready');
  }

  // ============================================================
  // FORM GABUNGAN
  // ============================================================
  function renderCombinedForm(prefillUser) {
    const initialUser = prefillUser || '';
    $('#era-slot').innerHTML = `
      <form id="era-step-form" autocomplete="on" novalidate>
        <div class="era-form-group">
          <label for="era-username">Username</label>
          <input class="era-input" id="era-username" name="username" type="text"
                 autocomplete="username" spellcheck="false"
                 value="${escapeHtml(initialUser)}" placeholder="Masukkan username">
        </div>
        <div class="era-form-group">
          <label for="era-otp">Kode OTP (6 digit)</label>
          <input class="era-input era-otp" id="era-otp" name="otp" type="text"
                 inputmode="numeric" pattern="[0-9]*" maxlength="6"
                 autocomplete="one-time-code" placeholder="••••••">
          <div class="era-hint" id="era-hint">Isi username + kode OTP, lalu klik Login.</div>
        </div>
        <div id="era-alert" class="era-alert era-hidden"></div>
        <button type="submit" class="era-btn-submit" id="era-submit">Login</button>
      </form>`;

    const otp = $('#era-otp');
    otp.addEventListener('input', () => { otp.value = otp.value.replace(/\D/g, '').slice(0, 6); });

    $('#era-step-form').addEventListener('submit', handleSubmit);
    showOriginalError();

    if (!initialUser) setTimeout(() => $('#era-username').focus(), 150);
    else setTimeout(() => otp.focus(), 150);
  }

  // ============================================================
  // SUBMIT
  // ============================================================
  async function handleSubmit(e) {
    e.preventDefault();
    hideAlert();

    const username = $('#era-username').value.trim();
    const otp = $('#era-otp').value.trim();

    if (!username) { showAlert('Username wajib diisi.'); $('#era-username').focus(); return; }
    if (otp.length !== 6) { showAlert('Kode OTP harus 6 digit.'); $('#era-otp').focus(); return; }

    const submitBtn = $('#era-submit');
    submitBtn.disabled = true;

    try {
      // ---------- STEP 1: username ----------
      submitBtn.innerHTML = '<span class="era-spinner"></span>Memeriksa username...';

      const action1 = getLoginAction();
      if (!action1) throw new Error('Form Keycloak tidak ditemukan.');

      const body1 = new URLSearchParams();
      body1.append('username', username);
      body1.append('login', 'Login');

      const res1 = await fetch(action1, {
        method: 'POST',
        credentials: 'include',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
        body: body1.toString(),
        redirect: 'follow',
      });

      const html1 = await res1.text();
      const doc1 = parseHTML(html1);
      const otpForm = doc1.querySelector('#kc-otp-login-form');
      const otpInput = doc1.querySelector('input[name="otp"]');
      const err1 = doc1.querySelector('#input-error, .pf-v5-c-alert, .kc-feedback-text');

      if (!otpForm || !otpInput) {
        if (err1 && err1.textContent.trim()) {
          showAlert(err1.textContent.trim());
        } else {
          const redirectUrl = extractRedirect(html1);
          if (redirectUrl) {
            await waitForSession();
            window.location.href = redirectUrl;
            return;
          }
          showAlert('Username tidak dikenali atau terjadi kesalahan.');
        }
        resetSubmitBtn();
        return;
      }

      saveUser(username);

      // ---------- STEP 2: OTP ----------
      submitBtn.innerHTML = '<span class="era-spinner"></span>Memverifikasi OTP...';

      const otpAction = otpForm.getAttribute('action');
      const hidden = collectHiddenInputs(otpForm);
      const body2 = new URLSearchParams();
      Object.entries(hidden).forEach(([k, v]) => body2.append(k, v));
      body2.append('otp', otp);
      body2.append('login', 'Login');

      const res2 = await fetch(otpAction, {
        method: 'POST',
        credentials: 'include',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
        body: body2.toString(),
        redirect: 'follow',
      });

      const finalUrl = res2.url || '';
      if (res2.redirected && !/\/login-actions\/authenticate/.test(finalUrl)) {
        submitBtn.innerHTML = '<span class="era-spinner"></span>Menyiapkan sesi...';
        const ready = await waitForSession(3, 300);
        console.log('[EraSSO] Sesi ready:', ready, '— redirect ke HRM');
        await new Promise(r => setTimeout(r, ready ? 150 : 500));
        // reset refresh counter karena login baru sukses
        try { sessionStorage.setItem(CFG.refreshCountKey, '0'); } catch (_) {}
        window.location.href = finalUrl;
        return;
      }

      const html2 = await res2.text();
      const doc2 = parseHTML(html2);
      const redirectUrl2 = extractRedirect(html2);
      if (redirectUrl2) {
        await waitForSession(3, 300);
        await new Promise(r => setTimeout(r, 150));
        try { sessionStorage.setItem(CFG.refreshCountKey, '0'); } catch (_) {}
        window.location.href = redirectUrl2;
        return;
      }

      const err2 = doc2.querySelector('#input-error, .pf-v5-c-alert, .kc-feedback-text');
      if (err2 && err2.textContent.trim()) {
        showAlert(err2.textContent.trim());
      } else if (doc2.querySelector('#kc-otp-login-form')) {
        showAlert('Kode OTP salah atau kedaluwarsa. Coba lagi.');
      } else {
        showAlert('Login gagal. Coba ulangi atau refresh.', 'info');
      }
      resetSubmitBtn();

    } catch (err) {
      console.error('[EraSSO] error:', err);
      showAlert('Gagal memproses login. Periksa koneksi atau coba lagi.');
      resetSubmitBtn();
    }
  }

  function resetSubmitBtn() {
    const btn = $('#era-submit');
    if (!btn) return;
    btn.disabled = false;
    btn.textContent = 'Login';
  }

  // ============================================================
  // UTIL
  // ============================================================
  function collectHiddenInputs(form) {
    const out = {};
    Array.from(form.querySelectorAll('input[type="hidden"]')).forEach(inp => {
      if (inp.name) out[inp.name] = inp.value;
    });
    return out;
  }

  function extractRedirect(html) {
    const doc = parseHTML(html);
    const meta = doc.querySelector('meta[http-equiv="refresh" i]');
    if (meta) {
      const m = meta.getAttribute('content').match(/url=(.+)$/i);
      if (m) return m[1].trim().replace(/^['"]|['"]$/g, '');
    }
    const m2 = html.match(/location\.(?:href|replace)\s*[=]\s*['"]([^'"]+)['"]/i);
    if (m2) return m2[1];
    return null;
  }

  function showAlert(msg, type='error') {
    const el = $('#era-alert'); if (!el) return;
    el.textContent = msg;
    el.className = 'era-alert' + (type === 'info' ? ' era-alert--info' :
      type === 'success' ? ' era-alert--success' : '');
  }
  function hideAlert() {
    const el = $('#era-alert'); if (el) el.classList.add('era-hidden');
  }
  function showOriginalError() {
    const err = $('.pf-v5-c-alert, #input-error, .kc-feedback-text');
    if (err && err.textContent.trim()) showAlert(err.textContent.trim());
  }

  // ============================================================
  // INIT (authkey only)
  // ============================================================
  function init() {
    if ($('#kc-otp-login-form') && $('input[name="otp"]')) {
      console.log('[EraSSO] Sudah di step OTP native — skip.');
      return;
    }
    const loginForm = $('#kc-form-login');
    const userInput = loginForm ? $('input[name="username"]', loginForm) : null;
    if (!loginForm || !userInput) {
      console.log('[EraSSO] Bukan step username. Skip.');
      return;
    }
    buildShell();
    renderCombinedForm(loadUser());
    console.log('[EraSSO] Form ID+OTP aktif.');
  }

  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
  else init();
})();
