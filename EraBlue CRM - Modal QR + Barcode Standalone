// ==UserScript==
// @name         EraBlue CRM - Modal QR + Barcode Standalone
// @namespace    https://crm.erablue.id/
// @version      1.0.0
// @description  QR + Barcode pada Modal Inventory Lock Detail
// @match        https://crm.erablue.id/*
// @run-at       document-idle
// @grant        none
// ==/UserScript==

(function () {
    'use strict';

    const CONFIG = {
        MODAL_SELECTOR: '#mdLockDetail',
        MODAL_INFO_SELECTOR: '#divStoreInfo',
        MODAL_TABLE_SELECTOR: '.tables-lockDetail',
        PANEL_ID: 'ebStandaloneQrBarcode'
    };

    let pendingModalContext = {
        sku: '',
        storeName: ''
    };


    /* =========================================================
       ESCAPE HTML
    ========================================================= */

    function escapeHTML(value) {
        return String(value || '')
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;')
            .replace(/'/g, '&#039;');
    }


    /* =========================================================
       LOAD QR CODE
    ========================================================= */

    function loadQRCode() {
        return new Promise((resolve, reject) => {

            if (typeof window.QRCode !== 'undefined') {
                resolve();
                return;
            }

            const existing = document.querySelector(
                'script[data-eb-standalone-qrcode]'
            );

            if (existing) {

                existing.addEventListener(
                    'load',
                    () => resolve(),
                    { once: true }
                );

                existing.addEventListener(
                    'error',
                    () => reject(
                        new Error('QRCode library failed')
                    ),
                    { once: true }
                );

                return;
            }

            const script = document.createElement('script');

            script.src =
                'https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js';

            script.dataset.ebStandaloneQrcode = '1';

            script.onload = () => resolve();

            script.onerror = () => reject(
                new Error('QRCode library failed')
            );

            document.head.appendChild(script);
        });
    }


    /* =========================================================
       LOAD BARCODE
    ========================================================= */

    function loadBarcode() {
        return new Promise((resolve, reject) => {

            if (typeof window.JsBarcode === 'function') {
                resolve();
                return;
            }

            const existing = document.querySelector(
                'script[data-eb-standalone-barcode]'
            );

            if (existing) {

                existing.addEventListener(
                    'load',
                    () => resolve(),
                    { once: true }
                );

                existing.addEventListener(
                    'error',
                    () => reject(
                        new Error('JsBarcode library failed')
                    ),
                    { once: true }
                );

                return;
            }

            const script = document.createElement('script');

            script.src =
                'https://cdn.jsdelivr.net/npm/jsbarcode@3.11.6/dist/JsBarcode.all.min.js';

            script.dataset.ebStandaloneBarcode = '1';

            script.onload = () => resolve();

            script.onerror = () => reject(
                new Error('JsBarcode library failed')
            );

            document.head.appendChild(script);
        });
    }


    /* =========================================================
       GET SKU
    ========================================================= */

    function getModalSKU(modal) {

        if (!modal) {
            return '';
        }

        /* -----------------------------------------------------
           1. Dari tabel modal
        ----------------------------------------------------- */

        const skuElements = modal.querySelectorAll(
            `${CONFIG.MODAL_TABLE_SELECTOR} i`
        );

        for (const element of skuElements) {

            const value = element.textContent
                .replace(/\s+/g, '')
                .trim();

            if (/^\d{8,20}$/.test(value)) {
                return value;
            }
        }


        /* -----------------------------------------------------
           2. Dari TD pertama
        ----------------------------------------------------- */

        const firstCells = modal.querySelectorAll(
            `${CONFIG.MODAL_TABLE_SELECTOR} td:first-child`
        );

        for (const cell of firstCells) {

            const matches = cell.textContent.match(
                /\b\d{8,20}\b/g
            );

            if (matches && matches.length) {
                return matches[0];
            }
        }


        /* -----------------------------------------------------
           3. Dari onclick
        ----------------------------------------------------- */

        const onclickElements =
            modal.querySelectorAll('[onclick]');

        for (const element of onclickElements) {

            const onclick =
                element.getAttribute('onclick') || '';

            const match = onclick.match(
                /['"](\d{8,20})['"]/
            );

            if (match) {
                return match[1];
            }
        }


        /* -----------------------------------------------------
           4. Global CRM
        ----------------------------------------------------- */

        try {

            if (window._ProducCodeID) {

                const value = String(
                    window._ProducCodeID
                )
                    .replace(/\s+/g, '');

                if (/^\d{8,20}$/.test(value)) {
                    return value;
                }
            }

        } catch (error) {}


        /* -----------------------------------------------------
           5. Context
        ----------------------------------------------------- */

        if (
            pendingModalContext &&
            pendingModalContext.sku
        ) {

            const value = String(
                pendingModalContext.sku
            )
                .replace(/\s+/g, '');

            if (/^\d{8,20}$/.test(value)) {
                return value;
            }
        }

        return '';
    }


    /* =========================================================
       GET PRODUCT NAME
    ========================================================= */

    function getModalProductName(modal) {

        if (!modal) {
            return '';
        }

        const cell = modal.querySelector(
            `${CONFIG.MODAL_TABLE_SELECTOR} tbody tr td:first-child`
        );

        if (!cell) {
            return '';
        }

        const clone = cell.cloneNode(true);

        const codeElement = clone.querySelector('i');

        if (codeElement) {
            codeElement.remove();
        }

        return clone.textContent
            .replace(/\s+/g, ' ')
            .trim();
    }


    /* =========================================================
       GET STORE NAME
    ========================================================= */

    function getModalStoreName(modal) {

        if (!modal) {
            return '';
        }

        const info = modal.querySelector(
            CONFIG.MODAL_INFO_SELECTOR
        );

        if (info) {

            const text = info.textContent
                .replace(/\s+/g, ' ')
                .trim();

            const match = text.match(
                /Store name:\s*([^]+?)(?=\s+Store type:|$)/i
            );

            if (match) {
                return match[1].trim();
            }
        }


        if (
            pendingModalContext &&
            pendingModalContext.storeName
        ) {
            return pendingModalContext.storeName;
        }

        return '';
    }


    /* =========================================================
       REMOVE PANEL
    ========================================================= */

    function removeModalCode() {

        const old = document.getElementById(
            CONFIG.PANEL_ID
        );

        if (old) {
            old.remove();
        }
    }


    /* =========================================================
       CREATE PANEL
    ========================================================= */

    async function createModalCode(modal) {

        if (!modal) {
            return;
        }

        const info = modal.querySelector(
            CONFIG.MODAL_INFO_SELECTOR
        );

        if (!info) {
            return;
        }

        const sku = getModalSKU(modal);

        if (!sku) {
            return;
        }


        /* Jangan duplicate */

        const old = document.getElementById(
            CONFIG.PANEL_ID
        );

        if (
            old &&
            old.dataset.sku === sku
        ) {
            return;
        }

        removeModalCode();


        const productName =
            getModalProductName(modal);

        const storeName =
            getModalStoreName(modal);


        /* =====================================================
           PANEL
        ===================================================== */

        const panel = document.createElement('div');

        panel.id = CONFIG.PANEL_ID;

        panel.dataset.sku = sku;

        panel.innerHTML = `
            <div class="eb-code-title">
                QR + BARCODE
            </div>

            <div
                class="eb-qr"
                id="ebStandaloneModalQR"
            ></div>

            <svg
                class="eb-barcode"
                id="ebStandaloneModalBarcode"
                xmlns="http://www.w3.org/2000/svg"
            ></svg>

            <div class="eb-code-value">
                ${escapeHTML(sku)}
            </div>

            ${
                productName
                    ? `
                        <div class="eb-code-sub">
                            ${escapeHTML(productName)}
                        </div>
                    `
                    : ''
            }

            ${
                storeName
                    ? `
                        <div class="eb-code-sub">
                            ${escapeHTML(storeName)}
                        </div>
                    `
                    : ''
            }

            <button
                type="button"
                class="eb-copy"
                id="ebStandaloneCopy"
            >
                Copy SKU
            </button>
        `;


        /*
         * Masukkan ke awal divStoreInfo.
         * CSS float:right akan membuat panel
         * berada di sebelah kanan.
         */

        info.insertBefore(
            panel,
            info.firstChild
        );


        /* =====================================================
           LOAD LIBRARY
        ===================================================== */

        try {

            await Promise.all([
                loadQRCode(),
                loadBarcode()
            ]);

        } catch (error) {

            console.error(
                '[EraBlue QR]',
                error
            );

            return;
        }


        /* =====================================================
           QR
        ===================================================== */

        const qr =
            document.getElementById(
                'ebStandaloneModalQR'
            );

        if (qr) {

            qr.innerHTML = '';

            new window.QRCode(qr, {
                text: sku,
                width: 150,
                height: 150,
                colorDark: '#000000',
                colorLight: '#ffffff',
                correctLevel:
                    window.QRCode.CorrectLevel.M
            });
        }


        /* =====================================================
           BARCODE
        ===================================================== */

        const barcode =
            document.getElementById(
                'ebStandaloneModalBarcode'
            );

        if (barcode) {

            window.JsBarcode(
                barcode,
                sku,
                {
                    format: 'CODE128',
                    width: 1.5,
                    height: 45,
                    displayValue: false,
                    margin: 0
                }
            );
        }


        /* =====================================================
           COPY SKU
        ===================================================== */

        const copyButton =
            document.getElementById(
                'ebStandaloneCopy'
            );

        if (copyButton) {

            copyButton.addEventListener(
                'click',
                async function () {

                    try {

                        await navigator.clipboard.writeText(
                            sku
                        );

                        const oldText =
                            this.textContent;

                        this.textContent =
                            'Copied';

                        setTimeout(() => {
                            this.textContent =
                                oldText;
                        }, 1000);

                    } catch (error) {

                        const textarea =
                            document.createElement(
                                'textarea'
                            );

                        textarea.value = sku;

                        document.body.appendChild(
                            textarea
                        );

                        textarea.select();

                        document.execCommand(
                            'copy'
                        );

                        textarea.remove();

                        this.textContent =
                            'Copied';

                        setTimeout(() => {
                            this.textContent =
                                'Copy SKU';
                        }, 1000);
                    }
                }
            );
        }
    }


    /* =========================================================
       CSS
    ========================================================= */

    function injectCSS() {

        if (
            document.getElementById(
                'ebStandaloneQrStyle'
            )
        ) {
            return;
        }

        const style =
            document.createElement('style');

        style.id =
            'ebStandaloneQrStyle';

        style.textContent = `

            #${CONFIG.PANEL_ID} {
                float: right !important;

                width: 185px !important;

                margin: 0 0 12px 18px !important;

                padding: 10px !important;

                background: #ffffff !important;

                border: 1px solid #cccccc !important;

                border-radius: 7px !important;

                box-sizing: border-box !important;

                text-align: center !important;

                color: #222222 !important;

                position: relative !important;

                z-index: 99999 !important;

                font-family:
                    Arial,
                    Helvetica,
                    sans-serif !important;
            }


            #${CONFIG.PANEL_ID} .eb-code-title {

                font-size: 12px !important;

                font-weight: bold !important;

                color: #222 !important;

                margin-bottom: 8px !important;
            }


            #${CONFIG.PANEL_ID} .eb-qr {

                width: 150px !important;

                height: 150px !important;

                margin: 0 auto 8px auto !important;

                display: flex !important;

                align-items: center !important;

                justify-content: center !important;

                background: #fff !important;
            }


            #${CONFIG.PANEL_ID} .eb-qr img {

                width: 150px !important;

                height: 150px !important;
            }


            #${CONFIG.PANEL_ID} .eb-qr canvas {

                width: 150px !important;

                height: 150px !important;
            }


            #${CONFIG.PANEL_ID} .eb-barcode {

                display: block !important;

                width: 160px !important;

                height: 45px !important;

                margin: 0 auto 8px auto !important;

                background: #fff !important;
            }


            #${CONFIG.PANEL_ID} .eb-code-value {

                margin-top: 5px !important;

                font-family: monospace !important;

                font-size: 11px !important;

                font-weight: bold !important;

                color: #111 !important;

                word-break: break-all !important;
            }


            #${CONFIG.PANEL_ID} .eb-code-sub {

                margin-top: 3px !important;

                color: #666 !important;

                font-size: 9px !important;

                line-height: 1.2 !important;

            }


            #${CONFIG.PANEL_ID} .eb-copy {

                margin-top: 7px !important;

                padding: 4px 9px !important;

                border: 1px solid #bbb !important;

                border-radius: 4px !important;

                background: #f5f5f5 !important;

                color: #222 !important;

                font-size: 10px !important;

                cursor: pointer !important;
            }


            #${CONFIG.PANEL_ID} .eb-copy:hover {

                background: #e9e9e9 !important;
            }

        `;

        document.head.appendChild(style);
    }


    /* =========================================================
       CHECK MODAL
    ========================================================= */

    function checkModal() {

        const modal =
            document.querySelector(
                CONFIG.MODAL_SELECTOR
            );

        if (!modal) {
            return;
        }


        const style =
            window.getComputedStyle(modal);

        const visible =
            style.display !== 'none' &&
            style.visibility !== 'hidden' &&
            modal.offsetWidth > 0 &&
            modal.offsetHeight > 0;

        if (!visible) {
            return;
        }


        createModalCode(modal);
    }


    /* =========================================================
       OBSERVER
    ========================================================= */

    function startObserver() {

        const observer =
            new MutationObserver(() => {

                clearTimeout(
                    window.__ebQrTimer
                );

                window.__ebQrTimer =
                    setTimeout(
                        checkModal,
                        100
                    );
            });


        observer.observe(
            document.body,
            {
                childList: true,
                subtree: true,
                attributes: true,
                attributeFilter: [
                    'style',
                    'class'
                ]
            }
        );
    }


    /* =========================================================
       INIT
    ========================================================= */

    function init() {

        injectCSS();

        startObserver();

        setTimeout(
            checkModal,
            500
        );
    }


    if (
        document.readyState ===
        'loading'
    ) {

        document.addEventListener(
            'DOMContentLoaded',
            init
        );

    } else {

        init();
    }

})();
